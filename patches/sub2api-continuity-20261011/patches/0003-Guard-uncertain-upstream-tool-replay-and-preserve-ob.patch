+package service
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+func TestExecutionReplayGuardDistinguishesRejectedAndUnknownOutcomes(t *testing.T) {
+	for _, test := range []struct {
+		name     string
+		platform string
+		tools    string
+		status   int
+		response string
+		blocked  bool
+	}{
+		{"client_function", PlatformOpenAI, `[{"type":"function","name":"write"}]`, 502, `{}`, false},
+		{"remote_timeout", PlatformOpenAI, `[{"type":"computer"}]`, 504, `{}`, true},
+		{"remote_gateway_failure", PlatformOpenAI, `[{"type":"mcp"}]`, 502, `{}`, true},
+		{"auth_rejected", PlatformOpenAI, `[{"type":"computer"}]`, 401, `{"error":{"code":"invalid_api_key"}}`, false},
+		{"capacity_rejected", PlatformOpenAI, `[{"type":"computer"}]`, 429, `{"error":{"code":"rate_limit_exceeded"}}`, false},
+		{"stream_capacity", PlatformOpenAI, `[{"type":"computer"}]`, 429, `{"type":"response.failed","response":{"error":{"code":"rate_limit_exceeded"}}}`, true},
+		{"anthropic_function", PlatformAnthropic, `[{"name":"write","input_schema":{}}]`, 502, `{}`, false},
+		{"anthropic_server_tool", PlatformAnthropic, `[{"type":"code_execution_20250825"}]`, 503, `{}`, true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			account := &Account{Platform: test.platform, Type: AccountTypeAPIKey, Credentials: map[string]any{"fast_failover": true}}
+			failure := &UpstreamFailoverError{StatusCode: test.status, ResponseBody: []byte(test.response), ResponseHeaders: make(http.Header), RetryableOnSameAccount: true}
+			err := guardUpstreamExecutionReplay(account, []byte(`{"tools":`+test.tools+`}`), failure)
+			require.Same(t, failure, err)
+			require.Equal(t, !test.blocked, failure.ShouldRetryNextAccount())
+			if test.blocked {
+				require.False(t, failure.RetryableOnSameAccount)
+			}
+		})
+	}
+}
+
+func TestExecutionReplayGuardUsesCurrentWebSocketTurnTools(t *testing.T) {
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	service := &OpenAIGatewayService{}
+	account := &Account{Platform: PlatformOpenAI, Type: AccountTypeAPIKey, Credentials: map[string]any{"fast_failover": true}}
+	for _, test := range []struct {
+		body  string
+		risky bool
+	}{
+		{`{"tools":[{"type":"function","name":"lookup"}]}`, false},
+		{`{"tools":[{"type":"code_interpreter"}]}`, true},
+		{`{"tools":[]}`, false},
+	} {
+		_, err := service.prepareOpenAIEncryptedAttempt(context.Background(), c, account, []byte(test.body))
+		require.NoError(t, err)
+		require.Equal(t, test.risky, c.GetBool("upstream_tool_execution_possible"))
+	}
+}
