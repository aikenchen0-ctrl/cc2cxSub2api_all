+//go:build unit
+
+package handler
+
+import (
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestServerToolUnknownExecutionDoesNotReplayOnAnotherAccount(t *testing.T) {
+	for _, scenario := range []struct {
+		failure string
+		calls   []int64
+		status  int
+	}{
+		{"http_502", []int64{1}, http.StatusBadGateway},
+		{"http_429", []int64{1, 2}, http.StatusOK},
+	} {
+		t.Run(scenario.failure, func(t *testing.T) {
+			upstream := &transparentFailoverUpstream{failure: scenario.failure}
+			h := newTransparentFailoverHandler(t, upstream, false, nil)
+			c, recorder := transparentFailoverContext("/v1/responses")
+			body := `{"model":"test-model","stream":true,"input":"run remote calculation","tools":[{"type":"code_interpreter","container":{"type":"auto"}}]}`
+			c.Request.Body = io.NopCloser(strings.NewReader(body))
+			c.Request.ContentLength = int64(len(body))
+			serveTransparentFailover(h, c)
+			require.Equal(t, scenario.calls, upstream.calls(), recorder.Body.String())
+			require.Equal(t, scenario.status, recorder.Code, recorder.Body.String())
+		})
+	}
+}
