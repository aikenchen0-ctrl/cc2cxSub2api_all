+package service
+
+import (
+	"errors"
+	"net/http"
+	"strings"
+
+	"github.com/tidwall/gjson"
+)
+
+// upstreamToolExecutionPossible 只检查工具定义，不解析工具结果中的字符串。
+// 原生客户端函数由下游执行；服务端工具和未知扩展可能在错误返回前已经执行。
+func upstreamToolExecutionPossible(body []byte, platform string) bool {
+	tools := gjson.GetBytes(body, "tools")
+	if !tools.Exists() || tools.Type == gjson.Null {
+		return false
+	}
+	if !tools.IsArray() {
+		return true
+	}
+	for _, tool := range tools.Array() {
+		typ := tool.Get("type").String()
+		if platform == PlatformAnthropic {
+			if typ == "" || typ == "custom" {
+				continue
+			}
+		} else if typ == "function" || typ == "custom" {
+			continue
+		}
+		return true
+	}
+	return false
+}
+
+func guardUpstreamExecutionReplay(account *Account, body []byte, err error) error {
+	platform := ""
+	if account != nil {
+		platform = account.Platform
+	}
+	return guardUpstreamExecutionReplayForProtocol(account, body, platform, err)
+}
+
+func guardUpstreamExecutionReplayForProtocol(account *Account, body []byte, protocol string, err error) error {
+	return guardUpstreamExecutionRisk(account, upstreamToolExecutionPossible(body, protocol), err)
+}
+
+func guardUpstreamExecutionRisk(account *Account, executionPossible bool, err error) error {
+	if err == nil || !account.IsFastFailoverEnabled() || !executionPossible {
+		return err
+	}
+	var failure *UpstreamFailoverError
+	if !errors.As(err, &failure) || !failure.ShouldRetryNextAccount() {
+		return err
+	}
+	// 只对明确的请求接收前拒绝保留切换；流内429或错误可能发生在工具执行后。
+	eventType := gjson.GetBytes(failure.ResponseBody, "type").String()
+	streamFailure := failure.UpstreamStreamFailure || strings.HasPrefix(eventType, "response.") ||
+		gjson.GetBytes(failure.ResponseBody, "response.error").Exists() ||
+		strings.Contains(strings.ToLower(failure.ResponseHeaders.Get("Content-Type")), "text/event-stream")
+	if !streamFailure {
+		switch failure.StatusCode {
+		case http.StatusUnauthorized, http.StatusPaymentRequired, http.StatusForbidden,
+			http.StatusNotFound, http.StatusMethodNotAllowed, http.StatusRequestEntityTooLarge,
+			http.StatusUnprocessableEntity, http.StatusTooManyRequests:
+			return err
+		}
+	}
+	failure.RetryableOnSameAccount = false
+	failure.OpenAIBoundedSameAccountRetry = false
+	failure.NextAccountAction = NextAccountStop
+	failure.Scope = GatewayFailureScopeRequest
+	failure.Reason = GatewayFailureReason("upstream_tool_execution_uncertain")
+	failure.ClientStatusCode = http.StatusBadGateway
+	failure.ClientMessage = "Upstream tool execution status is unknown; automatic replay stopped to avoid duplicate execution"
+	return err
+}
