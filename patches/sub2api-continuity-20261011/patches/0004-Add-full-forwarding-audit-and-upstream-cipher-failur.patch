+// 真实历史只从显式本地副本读取，HTTP 出口由内存替身接管，不调用上游或执行工具。
+func TestContinuityWireAuditLocalFixtures(t *testing.T) {
+	root := os.Getenv("CONTINUITY_WIRE_FIXTURES")
+	if root == "" {
+		t.Skip("未指定本地会话副本目录")
+	}
+	paths, err := filepath.Glob(filepath.Join(root, "*", "*", "captured-1.json"))
+	require.NoError(t, err)
+	require.NotEmpty(t, paths)
+	reports := make([]map[string]any, 0)
+	for _, path := range paths {
+		body, err := os.ReadFile(path)
+		require.NoError(t, err)
+		for _, passthrough := range []bool{false, true} {
+			upstream := &httpUpstreamRecorder{resp: &http.Response{
+				StatusCode: http.StatusOK,
+				Header:     http.Header{"Content-Type": []string{"text/event-stream"}},
+				Body:       io.NopCloser(strings.NewReader("data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_audit\",\"status\":\"completed\",\"output\":[],\"usage\":{\"input_tokens\":1,\"output_tokens\":0}}}\n\n")),
+			}}
+			c := newOpenAIRejectedFieldTestContext(body)
+			c.Request.Header.Set("User-Agent", "codex_cli_rs/0.144.1")
+			account := newOpenAIRejectedFieldTestAccount()
+			account.Extra["openai_passthrough"] = passthrough
+			_, err = newOpenAIRejectedFieldTestService(upstream).Forward(context.Background(), c, account, body)
+			require.NoError(t, err)
+			require.Len(t, upstream.bodies, 1)
+			before, after := continuityWireSummarize(body), continuityWireSummarize(upstream.bodies[0])
+			report := map[string]any{"fixture": filepath.Base(filepath.Dir(filepath.Dir(path))),
+				"passthrough": passthrough, "before": before, "after": after,
+				"tool_output_changed_fields":     continuityWireFieldChanges(body, upstream.bodies[0]),
+				"previous_response_id_unchanged": gjson.GetBytes(body, "previous_response_id").Raw == gjson.GetBytes(upstream.bodies[0], "previous_response_id").Raw}
+			reports = append(reports, report)
+			t.Logf("本地副本=%s 透传模式=%v 请求字节=%d→%d 发送次数=%d", report["fixture"], passthrough, before.Bytes, after.Bytes, len(upstream.bodies))
+		}
+	}
+	encoded, err := json.MarshalIndent(reports, "", "  ")
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(filepath.Join(root, "wire-audit.json"), encoded, 0600))
+}
