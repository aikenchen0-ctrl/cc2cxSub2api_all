+// 复现 HTTP 成功但流失败；错误文案来自上游，不得改成成功或触发工具历史清理。
+func TestForwardToolCipherFailurePreservesUpstreamError(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	const message = "Encrypted function output content could not be decrypted or decoded."
+	for _, passthrough := range []bool{false, true} {
+		t.Run(fmt.Sprintf("passthrough_%v", passthrough), func(t *testing.T) {
+			body := []byte(`{"model":"gpt-6-astra","stream":true,"store":false,"input":[{"type":"function_call","id":"fc_1","name":"probe","call_id":"call_1","arguments":"{}"},{"type":"function_call_output","call_id":"call_1","output":"done","encrypted_content":"opaque-tool-state"}]}`)
+			stream := `data: {"type":"response.failed","response":{"id":"resp_incident","status":"failed","error":{"code":"invalid_encrypted_content","type":"invalid_request_error","param":null,"message":"` + message + `"},"output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":" "}]}]}}` + "\n\n"
+			upstream := &httpUpstreamRecorder{resp: &http.Response{StatusCode: http.StatusOK,
+				Header: http.Header{"Content-Type": []string{"text/event-stream"}}, Body: io.NopCloser(strings.NewReader(stream))}}
+			recorder := httptest.NewRecorder()
+			c, _ := gin.CreateTestContext(recorder)
+			c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", bytes.NewReader(body))
+			c.Request.Header.Set("Content-Type", "application/json")
+			account := newOpenAIRejectedFieldTestAccount()
+			account.Extra["openai_passthrough"] = passthrough
+			account.Credentials["fast_failover"] = true
+			result, err := newOpenAIRejectedFieldTestService(upstream).Forward(context.Background(), c, account, body)
+			require.ErrorContains(t, err, message)
+			require.Len(t, upstream.bodies, 1)
+			require.Equal(t, continuityWireSummarize(body).TypeHashes, continuityWireSummarize(upstream.bodies[0]).TypeHashes)
+			require.True(t, c.Writer.Written())
+			require.Contains(t, recorder.Body.String(), message)
+			require.Contains(t, recorder.Body.String(), "response.failed")
+			require.NotContains(t, recorder.Body.String(), "response.completed")
+			require.True(t, result == nil || !result.SucceededForScheduling())
+		})
+	}
+}
