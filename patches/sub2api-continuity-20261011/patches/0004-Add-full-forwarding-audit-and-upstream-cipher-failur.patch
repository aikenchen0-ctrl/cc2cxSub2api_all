+type continuityWireInventory struct {
+	Bytes      int                       `json:"bytes"`
+	ItemCounts map[string]int            `json:"item_counts"`
+	TypeHashes map[string]string         `json:"type_hashes"`
+	Fields     map[string]map[string]int `json:"field_counts"`
+	Ciphertext map[string]map[string]int `json:"ciphertext_hash_counts"`
+}
+
+func continuityWireFieldChanges(before, after []byte) map[string]map[string]int {
+	index := map[string]gjson.Result{}
+	gjson.GetBytes(after, "input").ForEach(func(_, item gjson.Result) bool {
+		key := item.Get("type").String() + ":" + item.Get("call_id").String()
+		if item.Get("call_id").Exists() {
+			index[key] = item
+		}
+		return true
+	})
+	changes := map[string]map[string]int{}
+	gjson.GetBytes(before, "input").ForEach(func(_, item gjson.Result) bool {
+		typ := item.Get("type").String()
+		if !strings.HasSuffix(typ, "_output") || !item.Get("call_id").Exists() {
+			return true
+		}
+		next, ok := index[typ+":"+item.Get("call_id").String()]
+		if !ok {
+			return true
+		}
+		item.ForEach(func(key, value gjson.Result) bool {
+			if value.Raw != next.Get(key.String()).Raw {
+				if changes[typ] == nil {
+					changes[typ] = map[string]int{}
+				}
+				changes[typ][key.String()]++
+			}
+			return true
+		})
+		return true
+	})
+	return changes
+}
+
+// 只记录结构、计数和摘要；真实会话正文、密文及工具参数不得进入测试输出。
+func continuityWireSummarize(body []byte) continuityWireInventory {
+	result := continuityWireInventory{Bytes: len(body), ItemCounts: map[string]int{},
+		TypeHashes: map[string]string{}, Fields: map[string]map[string]int{}, Ciphertext: map[string]map[string]int{}}
+	byType := map[string][]json.RawMessage{}
+	gjson.GetBytes(body, "input").ForEach(func(_, item gjson.Result) bool {
+		typ := item.Get("type").String()
+		result.ItemCounts[typ]++
+		if result.Fields[typ] == nil {
+			result.Fields[typ] = map[string]int{}
+			result.Ciphertext[typ] = map[string]int{}
+		}
+		var decoded map[string]any
+		_ = decodeOpenAIJSONUseNumber([]byte(item.Raw), &decoded)
+		canonical, _ := json.Marshal(decoded)
+		byType[typ] = append(byType[typ], canonical)
+		for key := range decoded {
+			result.Fields[typ][key]++
+		}
+		var visit func(any)
+		visit = func(value any) {
+			switch node := value.(type) {
+			case map[string]any:
+				for key, child := range node {
+					if key == "encrypted_content" {
+						if ciphertext, ok := child.(string); ok && ciphertext != "" {
+							hash := sha256.Sum256([]byte(ciphertext))
+							result.Ciphertext[typ][hex.EncodeToString(hash[:])]++
+						}
+					}
+					visit(child)
+				}
+			case []any:
+				for _, child := range node {
+					visit(child)
+				}
+			}
+		}
+		visit(decoded)
+		return true
+	})
+	for typ, items := range byType {
+		canonical, _ := json.Marshal(items)
+		hash := sha256.Sum256(canonical)
+		result.TypeHashes[typ] = hex.EncodeToString(hash[:])
+	}
+	return result
+}
