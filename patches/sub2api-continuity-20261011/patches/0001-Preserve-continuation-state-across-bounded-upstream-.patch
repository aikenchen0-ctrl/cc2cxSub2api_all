+func TestAdaptiveFirstOutputUsesRecentModelEffortSamples(t *testing.T) {
+	now := time.Now()
+	state := &openAIAdaptiveFirstOutputState{}
+	require.Equal(t, time.Minute, state.timeout("model-a", "medium", now))
+	require.Equal(t, 5*time.Minute, state.timeout("model-a", "high", now))
+	state.observe("model-a", "high", 4*time.Minute, now)
+	require.Equal(t, 8*time.Minute+15*time.Second, state.timeout("model-a", "high", now))
+	require.Equal(t, 5*time.Minute, state.timeout("model-b", "high", now))
+	require.Equal(t, 5*time.Minute, state.timeout("model-a", "xhigh", now))
+	require.Equal(t, 5*time.Minute, state.timeout("model-a", "high", now.Add(openAIFirstOutputSampleTTL+time.Second)))
+	state.observe("model-a", "medium", time.Second, now)
+	require.Equal(t, time.Minute, state.timeout("model-a", "medium", now))
+}
+
+func TestAdaptiveFirstOutputP95AndHardLimits(t *testing.T) {
+	now := time.Now()
+	state := &openAIAdaptiveFirstOutputState{}
+	for i := 0; i < 20; i++ {
+		state.observe("model", "medium", 40*time.Second, now)
+	}
+	state.observe("model", "medium", 10*time.Minute, now)
+	require.Equal(t, 95*time.Second, state.timeout("model", "medium", now))
+	for _, effort := range []string{"medium", "high"} {
+		_, limit := openAIFirstOutputBounds(effort)
+		state.observe("slow", effort, time.Duration(1<<63-1), now)
+		require.Equal(t, limit, state.timeout("slow", effort, now))
+	}
+	state.observe("invalid", "high", -time.Second, now)
+	require.Nil(t, state.buckets[openAIFirstOutputKey("invalid", "high")])
+}
+
+func TestAdaptiveFirstOutputMemoryIsBoundedUnderConcurrency(t *testing.T) {
+	state := &openAIAdaptiveFirstOutputState{}
+	var workers sync.WaitGroup
+	for worker := 0; worker < 8; worker++ {
+		workers.Add(1)
+		go func(worker int) {
+			defer workers.Done()
+			for i := 0; i < 100; i++ {
+				model := fmt.Sprintf("model-%d-%d", worker, i)
+				state.observe(model, "high", time.Minute, time.Now())
+				_ = state.timeout(model, "high", time.Now())
+			}
+		}(worker)
+	}
+	workers.Wait()
+	require.Len(t, state.buckets, openAIFirstOutputSampleBuckets)
+}
