+//go:build unit
+
+package handler
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+)
+
+func TestOpenAIBoundedRetryRealHandlerLoop(t *testing.T) {
+	for _, rawChat := range []bool{false, true} {
+		for _, path := range []string{"/v1/responses", "/v1/chat/completions", "/v1/messages"} {
+			for _, failure := range []string{"short_502_once", "short_502_always"} {
+				name := path + "/" + failure
+				if rawChat {
+					name += "/raw"
+				}
+				t.Run(name, func(t *testing.T) {
+					upstream := &transparentFailoverUpstream{failure: failure}
+					h := newTransparentFailoverHandler(t, upstream, rawChat, nil)
+					c, rec := transparentFailoverContext(path)
+					serveTransparentFailover(h, c)
+					want := []int64{1, 1}
+					if failure == "short_502_always" {
+						want = append(want, 2)
+					}
+					require.Equal(t, want, upstream.calls(), rec.Body.String())
+					require.Equal(t, http.StatusOK, rec.Code)
+					require.Contains(t, rec.Body.String(), "healthy-output")
+					require.NotContains(t, rec.Body.String(), "temporary upstream unavailable")
+					outputCount := 0
+					for _, line := range strings.Split(rec.Body.String(), "\n") {
+						data := strings.TrimSpace(strings.TrimPrefix(line, "data:"))
+						if gjson.Get(data, "delta").String() == "healthy-output" ||
+							gjson.Get(data, "delta.text").String() == "healthy-output" ||
+							gjson.Get(data, "choices.0.delta.content").String() == "healthy-output" {
+							outputCount++
+						}
+					}
+					require.Equal(t, 1, outputCount)
+				})
+			}
+		}
+	}
+}
