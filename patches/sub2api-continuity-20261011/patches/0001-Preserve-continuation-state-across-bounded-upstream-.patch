+
+func TestEncryptedIssuerDoesNotOverrideSuccessfulCompatibleFailover(t *testing.T) {
+	server := miniredis.RunT(t)
+	client := redis.NewClient(&redis.Options{Addr: server.Addr()})
+	t.Cleanup(func() { _ = client.Close() })
+	cache := repository.NewGatewayCache(client)
+	digest := sha256.Sum256([]byte("old_cipher"))
+	identity := sha256.Sum256([]byte("openai\x00https://upstream.example.test\x00test-key\x00test-model"))
+	require.NoError(t, cache.(service.OpenAIEncryptedOwnerCache).SetOpenAIEncryptedOwners(context.Background(), 3131, 99,
+		[]string{hex.EncodeToString(digest[:])}, service.OpenAIEncryptedOwner{AccountID: 1, Identity: hex.EncodeToString(identity[:])}, time.Hour))
+	upstream := &transparentFailoverUpstream{failure: "http_429"}
+	h := newTransparentFailoverHandler(t, upstream, false, nil, cache)
+	for turn := 0; turn < 3; turn++ {
+		c, rec := transparentFailoverContext("/v1/responses")
+		body := `{"model":"test-model","stream":true,"input":[{"role":"user","content":"continue"},{"type":"reasoning","encrypted_content":"old_cipher","summary":[]}]}`
+		c.Request.Body = io.NopCloser(strings.NewReader(body))
