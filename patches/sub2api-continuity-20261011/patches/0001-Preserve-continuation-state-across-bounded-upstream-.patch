diff --git a/sub2api/backend/internal/repository/gateway_cache_encrypted_owner.go b/sub2api/backend/internal/repository/gateway_cache_encrypted_owner.go
new file mode 100644
index 0000000..4c0099c
--- /dev/null
+++ b/sub2api/backend/internal/repository/gateway_cache_encrypted_owner.go
@@ -0,0 +1,97 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/redis/go-redis/v9"
+)
+
+func encryptedOwnerKey(groupID, keyID int64) string {
+	return fmt.Sprintf("openai_encrypted_owner:%d:%d", groupID, keyID)
+}
+
+// 每个客户密钥最多保存16384个摘要，逐批移除过期项；容量满时旧归属退为未知。
+var storeEncryptedOwners = redis.NewScript(`
+local expired = redis.call('ZRANGEBYSCORE', KEYS[2], '-inf', ARGV[1], 'LIMIT', 0, 256)
+for _, key in ipairs(expired) do redis.call('HDEL', KEYS[1], key); redis.call('ZREM', KEYS[2], key) end
+for i=4,#ARGV do
+  if redis.call('HEXISTS', KEYS[1], ARGV[i]) == 0 then
+    redis.call('HSET', KEYS[1], ARGV[i], ARGV[3])
+    redis.call('ZADD', KEYS[2], ARGV[2], ARGV[i])
+  end
+end
+local excess = redis.call('ZCARD', KEYS[2]) - 16384
+if excess > 0 then
+  local oldest = redis.call('ZRANGE', KEYS[2], 0, excess-1)
+  for _, key in ipairs(oldest) do redis.call('HDEL', KEYS[1], key); redis.call('ZREM', KEYS[2], key) end
+end
+redis.call('PEXPIRE', KEYS[1], ARGV[2]-ARGV[1])
+redis.call('PEXPIRE', KEYS[2], ARGV[2]-ARGV[1])
+return 1
+`)
+
+var readEncryptedOwners = redis.NewScript(`
+local result = {}
+for i=2,#ARGV do
+  local expiry = redis.call('ZSCORE', KEYS[2], ARGV[i])
+  if expiry and tonumber(expiry) > tonumber(ARGV[1]) then
+    local value = redis.call('HGET', KEYS[1], ARGV[i])
+    if value then table.insert(result, ARGV[i]); table.insert(result, value) end
+  end
+end
+return result
+`)
+
+func (c *gatewayCache) GetOpenAIEncryptedOwners(ctx context.Context, groupID, keyID int64, digests []string) ([]service.OpenAIEncryptedOwner, error) {
+	if len(digests) == 0 {
+		return nil, nil
+	}
+	key := encryptedOwnerKey(groupID, keyID)
+	owners := make([]service.OpenAIEncryptedOwner, 0, len(digests))
+	for start := 0; start < len(digests); start += 128 {
+		args := []any{time.Now().UnixMilli()}
+		for _, digest := range digests[start:min(start+128, len(digests))] {
+			args = append(args, digest)
+		}
+		values, err := readEncryptedOwners.Run(ctx, c.rdb, []string{key, key + ":expiry"}, args...).Slice()
+		if err != nil {
+			return nil, err
+		}
+		for index := 0; index+1 < len(values); index += 2 {
+			digest, digestOK := values[index].(string)
+			text, textOK := values[index+1].(string)
+			var owner service.OpenAIEncryptedOwner
+			if digestOK && textOK && json.Unmarshal([]byte(text), &owner) == nil {
+				owner.Digest = digest
+				owners = append(owners, owner)
+			}
+		}
+	}
+	return owners, nil
+}
+
+func (c *gatewayCache) SetOpenAIEncryptedOwners(ctx context.Context, groupID, keyID int64, digests []string, owner service.OpenAIEncryptedOwner, ttl time.Duration) error {
+	value, err := json.Marshal(owner)
+	if err != nil {
+		return err
+	}
+	if len(digests) == 0 {
+		return nil
+	}
+	key := encryptedOwnerKey(groupID, keyID)
+	for start := 0; start < len(digests); start += 128 {
+		now := time.Now()
+		args := []any{now.UnixMilli(), now.Add(ttl).UnixMilli(), string(value)}
+		for _, digest := range digests[start:min(start+128, len(digests))] {
+			args = append(args, digest)
+		}
+		if _, err := storeEncryptedOwners.Run(ctx, c.rdb, []string{key, key + ":expiry"}, args...).Result(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
