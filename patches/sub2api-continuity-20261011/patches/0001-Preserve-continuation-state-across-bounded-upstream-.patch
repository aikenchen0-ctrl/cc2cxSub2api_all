diff --git a/sub2api/backend/internal/service/openai_bounded_same_account_retry.go b/sub2api/backend/internal/service/openai_bounded_same_account_retry.go
new file mode 100644
index 0000000..10e256a
--- /dev/null
+++ b/sub2api/backend/internal/service/openai_bounded_same_account_retry.go
@@ -0,0 +1,125 @@
+package service
+
+import (
+	"errors"
+	"math/rand/v2"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/tidwall/gjson"
+)
+
+// 仅分类已经结束的短故障；此值绝不用于取消正常推理或限制重试后的响应时间。
+const openAIShortFailureThreshold = 2 * time.Second
+
+type openAIUpstreamRetryAttempt struct {
+	startedAt   time.Time
+	requestBody []byte
+}
+
+func openAIRequestAllowsBoundedRetry(body []byte) bool {
+	if !gjson.ValidBytes(body) || !gjson.ParseBytes(body).IsObject() || gjson.GetBytes(body, "background").Bool() {
+		return false
+	}
+	if !gjson.GetBytes(body, "input").Exists() && !gjson.GetBytes(body, "messages").IsArray() {
+		return false
+	}
+	// 客户端函数尚未交付时可重放；服务端工具可能已执行，保守禁止自动同号重试。
+	tools := gjson.GetBytes(body, "tools")
+	if tools.Exists() && !tools.IsArray() {
+		return false
+	}
+	for _, tool := range tools.Array() {
+		switch tool.Get("type").String() {
+		case "function", "custom":
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+func openAIShortFailureIsAccountRejection(body []byte) bool {
+	if isOpenAICompatibleModelNotFoundBody(body) || isOpenAIUpstreamAccessStateError("", body) {
+		return true
+	}
+	// 结构化错误仅检查错误字段，防止回显用户正文改变调度决策。
+	values := make([]string, 0, 6)
+	for _, path := range []string{"code", "type", "message", "error.code", "error.type", "error.message", "response.error.code", "response.error.message"} {
+		values = append(values, gjson.GetBytes(body, path).String())
+	}
+	if !gjson.ValidBytes(body) {
+		values = append(values, string(body))
+	}
+	for _, value := range values {
+		value = strings.ToLower(value)
+		for _, marker := range []string{"insufficient balance", "insufficient account balance", "insufficient_balance", "insufficient_quota", "insufficient credit", "billing", "invalid_api_key", "authentication", "unauthorized", "permission_denied", "access forbidden", "access denied", "model_not_found", "model not found", "unknown model", "invalid_request_error", "content_policy", "safety_violation", "previous_response_not_found"} {
+			if strings.Contains(value, marker) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (s *OpenAIGatewayService) allowOpenAIBoundedSameAccountRetry(
+	c *gin.Context,
+	account *Account,
+	canonicalModel string,
+	failure *UpstreamFailoverError,
+	shouldDisable bool,
+	attempt openAIUpstreamRetryAttempt,
+) *UpstreamFailoverError {
+	if failure == nil || !account.ShouldFailoverImmediately(http.StatusBadGateway) || shouldDisable ||
+		!failure.ShouldRetryNextAccount() || account.GetPoolModeRetryCount() <= 0 ||
+		(failure.StatusCode != http.StatusBadGateway && failure.StatusCode != http.StatusServiceUnavailable) {
+		return failure
+	}
+	elapsed := time.Since(attempt.startedAt)
+	if attempt.startedAt.IsZero() || elapsed < 0 || elapsed > openAIShortFailureThreshold ||
+		!openAIRequestAllowsBoundedRetry(attempt.requestBody) ||
+		(c != nil && (c.Writer.Written() || (c.Request != nil && c.Request.Context().Err() != nil))) ||
+		failure.IsCredentialFailure() || failure.Scope == GatewayFailureScopeRequest ||
+		isOpenAIContextWindowError("", failure.ResponseBody) || openAIShortFailureIsAccountRejection(failure.ResponseBody) {
+		return failure
+	}
+	if hit, _, _ := detectOpenAICyberPolicy(failure.ResponseBody); hit {
+		return failure
+	}
+	// 账号或模型已冷却时不能用本次重试绕过；上游要求等待时直接选择其他账号。
+	if accountPersistedSchedulingCooldownActive(account) || s.isOpenAIAccountRuntimeBlocked(account) ||
+		s.getOpenAIAccountModelTransientState().isBlocked(account.ID, openAIAccountModelTransientModel(canonicalModel), time.Now()) ||
+		strings.TrimSpace(failure.ResponseHeaders.Get("Retry-After")) != "" {
+		return failure
+	}
+	failure.RetryableOnSameAccount = true
+	failure.OpenAIBoundedSameAccountRetry = true
+	failure.SameAccountRetryMax = 1
+	failure.SameAccountRetryDelay = time.Duration(200+rand.IntN(301)) * time.Millisecond
+	// 次数由请求级账号计数持有，禁止每次重建错误时产生新的时间窗口。
+	failure.SameAccountRetryDeadline = time.Time{}
+	return failure
+}
+
+func (s *OpenAIGatewayService) handleOpenAIUpstreamTransportErrorWithAttempt(
+	baseErr error,
+	c *gin.Context,
+	account *Account,
+	canonicalModel string,
+	transportErr error,
+	attempt openAIUpstreamRetryAttempt,
+) error {
+	var failure *UpstreamFailoverError
+	if !errors.As(baseErr, &failure) || classifyUpstreamTransportError(transportErr).Persistent {
+		return baseErr
+	}
+	// 只接受明确的拨号阶段失败；未知 EOF、写入失败及读超时都可能已发送请求。
+	var opErr *net.OpError
+	if !errors.As(transportErr, &opErr) || opErr.Op != "dial" {
+		return baseErr
+	}
+	return s.allowOpenAIBoundedSameAccountRetry(c, account, canonicalModel, failure, false, attempt)
+}
