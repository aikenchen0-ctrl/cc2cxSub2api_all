+//go:build unit
+
+package handler
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/repository"
+	"github.com/alicebob/miniredis/v2"
+	"github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+)
+
+func TestEncryptedRecoveryThreeTurnsAcrossHandlerInstances(t *testing.T) {
+	server := miniredis.RunT(t)
+	client := redis.NewClient(&redis.Options{Addr: server.Addr()})
+	t.Cleanup(func() { _ = client.Close() })
+	for turn := 0; turn < 3; turn++ {
+		upstream := &transparentFailoverUpstream{failure: "invalid_cipher"}
+		// 每轮创建新服务实例，证明恢复状态不依赖上一进程的内存。
+		h := newTransparentFailoverHandler(t, upstream, false, nil, repository.NewGatewayCache(client))
+		c, rec := transparentFailoverContext("/v1/responses")
+		body := fmt.Sprintf(`{"model":"test-model","stream":true,"input":[{"role":"user","content":"continue"},{"type":"reasoning","id":"rs_old","encrypted_content":"old_cipher","summary":[]},{"type":"function_call","call_id":"build_1","name":"build","arguments":"{}"},{"type":"function_call_output","call_id":"build_1","output":"completed without error"},{"type":"reasoning","id":"rs_new","encrypted_content":"new_cipher_%d","summary":[]}]}`, turn)
+		c.Request.Body = io.NopCloser(strings.NewReader(body))
+		c.Request.ContentLength = int64(len(body))
+		serveTransparentFailover(h, c)
+		require.Equal(t, http.StatusOK, rec.Code, rec.Body.String())
+		require.Contains(t, rec.Body.String(), "response.completed")
+		if turn == 0 {
+			require.Len(t, upstream.calls(), 2, "首轮明确拒绝后只恢复一次")
+		} else {
+			require.Len(t, upstream.calls(), 1, "后续实例应复用持久记录，不再先失败一次")
+		}
+		wire := upstream.bodies[len(upstream.bodies)-1]
+		require.False(t, gjson.GetBytes(wire, "input.1.encrypted_content").Exists())
+		require.Equal(t, fmt.Sprintf("new_cipher_%d", turn), gjson.GetBytes(wire, "input.4.encrypted_content").String())
+		for _, index := range []int{2, 3} {
+			path := fmt.Sprintf("input.%d", index)
+			require.JSONEq(t, gjson.Get(body, path).Raw, gjson.GetBytes(wire, path).Raw)
+		}
+	}
+}
