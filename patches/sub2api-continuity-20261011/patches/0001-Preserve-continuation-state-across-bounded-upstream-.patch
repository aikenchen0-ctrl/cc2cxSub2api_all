+	for _, path := range []string{"message", "error.message", "detail"} {
+		value := gjson.GetBytes(responseBody, path)
+		if value.Type != gjson.String {
+			continue
+		}
+		message := strings.ToLower(value.String())
+		for _, marker := range []string{"insufficient account balance", "insufficient balance", "billing balance exhausted"} {
+			if strings.Contains(message, marker) {
+				return true
+			}
+		}
+	}
+	return false
+}
