+// shouldApplyPoolModeOpenAI403HealthPolicy 按快速切换开关识别明确余额故障。
+// 不依赖账号编号或池模式；其他权限、区域、策略和链路错误保持原策略。
+func shouldApplyPoolModeOpenAI403HealthPolicy(account *Account, statusCode int, responseBody []byte) bool {
+	if (statusCode != http.StatusForbidden && statusCode != http.StatusPaymentRequired) || !account.ShouldFailoverImmediately(statusCode) {
