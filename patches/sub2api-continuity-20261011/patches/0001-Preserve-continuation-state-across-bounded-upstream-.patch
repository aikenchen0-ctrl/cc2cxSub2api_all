diff --git a/sub2api/backend/internal/service/openai_encrypted_recovery.go b/sub2api/backend/internal/service/openai_encrypted_recovery.go
new file mode 100644
index 0000000..eced67c
--- /dev/null
+++ b/sub2api/backend/internal/service/openai_encrypted_recovery.go
@@ -0,0 +1,146 @@
+package service
+
+import (
+	"context"
+	"fmt"
+	"log/slog"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/tidwall/gjson"
+)
+
+// OpenAIEncryptedRecoveryCache 只保存已拒绝的推理摘要，不保存客户正文或密文。
+// 目标身份包含实际端点、凭据和模型，避免某个上游的拒绝影响其他兼容上游。
+type OpenAIEncryptedRecoveryCache interface {
+	GetOpenAIEncryptedRecovery(context.Context, int64, int64, string, []string) (map[string]struct{}, error)
+	SetOpenAIEncryptedRecovery(context.Context, int64, int64, string, []string, time.Duration) error
+}
+
+const openAIEncryptedRecoveryScopeKey = "openai_encrypted_recovery_scope_v1"
+
+var openAIRejectedInputIndex = regexp.MustCompile(`^input(?:\[(\d+)\]|\.(\d+))(?:\.encrypted_content)?$`)
+
+func openAIRejectedReasoningDigests(body, failure []byte) map[string]struct{} {
+	result := make(map[string]struct{})
+	if !AnalyzeOpenAIContinuationSafety(body).CanRecoverRejectedEncryptedReasoning() {
+		return result
+	}
+	message := strings.ToLower(extractUpstreamErrorMessage(failure))
+	if strings.Contains(message, "function output") || strings.Contains(message, "tool") || strings.Contains(message, "compaction") {
+		return result
+	}
+	param := gjson.GetBytes(failure, "error.param").String()
+	if match := openAIRejectedInputIndex.FindStringSubmatch(param); match != nil {
+		value := match[1]
+		if value == "" {
+			value = match[2]
+		}
+		index, _ := strconv.Atoi(value)
+		item := gjson.GetBytes(body, fmt.Sprintf("input.%d", index))
+		cipher := item.Get("encrypted_content")
+		if item.Get("type").String() == "reasoning" && cipher.Type == gjson.String && cipher.String() != "" {
+			result[openAIEncryptedContentDigest(cipher.String())] = struct{}{}
+		}
+		return result
+	}
+	// 上游未指出具体项时，只有一个推理密文才能无歧义定位；不猜测整包均坏。
+	if digests := collectOpenAIEncryptedContentDigestsRaw(body); len(digests) == 1 {
+		result[digests[0]] = struct{}{}
+	}
+	return result
+}
+
+type openAIEncryptedRecoveryScope struct {
+	accountID int64
+	target    string
+}
+
+// 内存兼容记录也必须隔离客户和目标，不能沿用旧的纯会话哈希。
+func (s *OpenAIGatewayService) encryptedRecoverySessionKey(c *gin.Context, body []byte) string {
+	if c == nil || getAPIKeyIDFromContext(c) <= 0 {
+		return ""
+	}
+	value, _ := c.Get(openAIEncryptedRecoveryScopeKey)
+	scope, ok := value.(openAIEncryptedRecoveryScope)
+	if !ok || scope.target == "" {
+		return ""
+	}
+	return fmt.Sprintf("recovery:v1:%d:%s:%s", getAPIKeyIDFromContext(c), scope.target, s.GenerateSessionHash(c, body))
+}
+
+func (s *OpenAIGatewayService) prepareOpenAIEncryptedRecovery(ctx context.Context, c *gin.Context, account *Account, body []byte) []byte {
+	if s == nil || c == nil || account == nil || account.Platform != PlatformOpenAI || account.Type != AccountTypeAPIKey {
+		if c != nil {
+			c.Set(openAIEncryptedRecoveryScopeKey, openAIEncryptedRecoveryScope{})
+		}
+		return body
+	}
+	model := canonicalOpenAIAccountSchedulingModel(account, gjson.GetBytes(body, "model").String())
+	scope := openAIEncryptedRecoveryScope{accountID: account.ID, target: openAIEncryptedIdentity(account, model)}
+	c.Set(openAIEncryptedRecoveryScopeKey, scope)
+	cache, ok := s.cache.(OpenAIEncryptedRecoveryCache)
+	if !ok || !AnalyzeOpenAIContinuationSafety(body).CanRecoverRejectedEncryptedReasoning() {
+		return body
+	}
+	digests := collectOpenAIEncryptedContentDigestsRaw(body)
+	if len(digests) == 0 {
+		return body
+	}
+	lookupCtx, cancel := context.WithTimeout(ctx, 100*time.Millisecond)
+	invalid, err := cache.GetOpenAIEncryptedRecovery(lookupCtx, getOpenAIGroupIDFromContext(c), getAPIKeyIDFromContext(c), scope.target, digests)
+	cancel()
+	if err != nil {
+		slog.Warn("openai.encrypted_recovery_read_failed", "account_id", account.ID)
+		return body
+	}
+	updated, count, err := stripOpenAIInvalidEncryptedContentRaw(body, invalid)
+	if err != nil || count == 0 {
+		return body
+	}
+	slog.Info("openai.encrypted_recovery_applied", "account_id", account.ID, "items", count)
+	return updated
+}
+
+func (s *OpenAIGatewayService) rememberOpenAIEncryptedRecovery(c *gin.Context, body []byte, accountID int64, selected ...map[string]struct{}) {
+	if s == nil || c == nil || !AnalyzeOpenAIContinuationSafety(body).CanRecoverRejectedEncryptedReasoning() {
+		return
+	}
+	cache, ok := s.cache.(OpenAIEncryptedRecoveryCache)
+	if !ok {
+		return
+	}
+	value, _ := c.Get(openAIEncryptedRecoveryScopeKey)
+	scope, ok := value.(openAIEncryptedRecoveryScope)
+	if !ok || scope.accountID != accountID || scope.target == "" {
+		return
+	}
+	digests := collectOpenAIEncryptedContentDigestsRaw(body)
+	if len(selected) > 0 {
+		filtered := digests[:0]
+		for _, digest := range digests {
+			if _, ok := selected[0][digest]; ok {
+				filtered = append(filtered, digest)
+			}
+		}
+		digests = filtered
+	} else if len(digests) != 1 {
+		return
+	}
+	if len(digests) == 0 {
+		return
+	}
+	ctx := context.Background()
+	if c.Request != nil {
+		ctx = c.Request.Context()
+	}
+	writeCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 100*time.Millisecond)
+	defer cancel()
+	// 两天内重复引用刷新摘要期限；不借此延长任何正文的保留时间。
+	if err := cache.SetOpenAIEncryptedRecovery(writeCtx, getOpenAIGroupIDFromContext(c), getAPIKeyIDFromContext(c), scope.target, digests, 48*time.Hour); err != nil {
+		slog.Warn("openai.encrypted_recovery_write_failed", "account_id", accountID)
+	}
+}
