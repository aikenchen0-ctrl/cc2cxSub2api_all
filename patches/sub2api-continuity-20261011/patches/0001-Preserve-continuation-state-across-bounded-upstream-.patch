diff --git a/sub2api/backend/internal/service/anthropic_continuation_recovery.go b/sub2api/backend/internal/service/anthropic_continuation_recovery.go
new file mode 100644
index 0000000..35e3ae1
--- /dev/null
+++ b/sub2api/backend/internal/service/anthropic_continuation_recovery.go
@@ -0,0 +1,163 @@
+package service
+
+import (
+	"encoding/json"
+	"strings"
+
+	"github.com/tidwall/gjson"
+)
+
+// closedAnthropicHistoryBoundary 只认可工具轮之后确有助手收尾和新的用户输入。
+// 工具结果本身不等于整轮结束；当前工具循环、并行缺项或不透明结果不降级。
+func closedAnthropicHistoryBoundary(messages []any) int {
+	boundary := -1
+	pending := map[string]bool{}
+	closedAssistant := false
+	for index, raw := range messages {
+		message, ok := raw.(map[string]any)
+		if !ok {
+			return -1
+		}
+		role, _ := message["role"].(string)
+		text := false
+		toolBlocks := false
+		hasCalls := false
+		switch content := message["content"].(type) {
+		case string:
+			text = strings.TrimSpace(content) != ""
+		case []any:
+			for _, value := range content {
+				block, ok := value.(map[string]any)
+				if !ok {
+					return -1
+				}
+				switch block["type"] {
+				case "text":
+					value, _ := block["text"].(string)
+					text = text || strings.TrimSpace(value) != ""
+				case "thinking", "redacted_thinking":
+				case "tool_use":
+					id, _ := block["id"].(string)
+					if role != "assistant" || id == "" || pending[id] {
+						return -1
+					}
+					pending[id], toolBlocks, hasCalls = true, true, true
+				case "tool_result":
+					id, _ := block["tool_use_id"].(string)
+					if role != "user" || !pending[id] || !anthropicToolResultHasCompleteText(block) {
+						return -1
+					}
+					delete(pending, id)
+					toolBlocks = true
+				default:
+					// 服务端工具、附件和未知扩展没有已验证的等价文本替代。
+					return -1
+				}
+			}
+		default:
+			return -1
+		}
+		if role == "user" && text && !toolBlocks && closedAssistant && len(pending) == 0 {
+			boundary = index
+		}
+		if role == "assistant" {
+			closedAssistant = text && !hasCalls && len(pending) == 0
+		}
+		if index == len(messages)-1 && (role != "user" || toolBlocks || !text) {
+			return -1
+		}
+	}
+	if len(pending) != 0 {
+		return -1
+	}
+	return boundary
+}
+
+func anthropicToolResultHasCompleteText(block map[string]any) bool {
+	if _, exists := block["encrypted_content"]; exists {
+		return false
+	}
+	switch content := block["content"].(type) {
+	case string:
+		return true
+	case []any:
+		for _, value := range content {
+			item, ok := value.(map[string]any)
+			if !ok || item["type"] != "text" {
+				return false
+			}
+			if _, ok := item["text"].(string); !ok {
+				return false
+			}
+		}
+		return true
+	default:
+		return false
+	}
+}
+
+// prepareAnthropicHistoryRecovery 保留当前 thinking 配置、当前工具轮和全部实际结果。
+// 文本兜底须由管理配置显式允许，只转换已闭合历史；不承担缺失明文的重建。
+func prepareAnthropicHistoryRecovery(body []byte, model string, toolsAsText bool) ([]byte, bool) {
+	if !ShouldApplyRetryFilters(model) || !gjson.ValidBytes(body) {
+		return body, false
+	}
+	var request map[string]any
+	if decodeOpenAIJSONUseNumber(body, &request) != nil {
+		return body, false
+	}
+	messages, ok := request["messages"].([]any)
+	if !ok {
+		return body, false
+	}
+	boundary := closedAnthropicHistoryBoundary(messages)
+	if boundary < 0 {
+		return body, false
+	}
+	changed := false
+	for index, raw := range messages {
+		message := raw.(map[string]any)
+		blocks, ok := message["content"].([]any)
+		if !ok {
+			continue
+		}
+		for position, value := range blocks {
+			block := value.(map[string]any)
+			switch block["type"] {
+			case "redacted_thinking":
+				// 隐藏块没有明文，不能声称转换后仍保留其内容。
+				return body, false
+			case "thinking":
+				if index >= boundary {
+					return body, false
+				}
+				text, _ := block["thinking"].(string)
+				if strings.TrimSpace(text) == "" {
+					return body, false
+				}
+				blocks[position] = map[string]any{"type": "text", "text": text}
+				changed = true
+			case "tool_use", "tool_result":
+				if !toolsAsText || index >= boundary {
+					continue
+				}
+				// 将整个原始结构编码进历史记录，保留参数原串、结果和错误标记。
+				// 明示数据身份只能缓解信任变化，不能等价替代原生工具角色。
+				archive, err := json.Marshal(map[string]any{"history_kind": "completed_tool_record", "record": block})
+				if err != nil {
+					return body, false
+				}
+				blocks[position] = map[string]any{"type": "text", "text": string(archive)}
+				changed = true
+			}
+		}
+	}
+	if !changed {
+		return body, false
+	}
+	updated, err := json.Marshal(request)
+	if err != nil {
+		return body, false
+	}
+	return updated, true
+}
