diff --git a/sub2api/backend/internal/service/openai_sticky_success.go b/sub2api/backend/internal/service/openai_sticky_success.go
new file mode 100644
index 0000000..081d49d
--- /dev/null
+++ b/sub2api/backend/internal/service/openai_sticky_success.go
@@ -0,0 +1,109 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+)
+
+// OpenAIStickySuccessCache 用版本快照和原子提交隔离并发请求，不改变已有账号键格式。
+type OpenAIStickySuccessCache interface {
+	GetOpenAIStickySnapshot(context.Context, int64, string) (int64, string, error)
+	CommitOpenAIStickySuccess(context.Context, int64, string, int64, string, int64, time.Duration, string, time.Duration) (string, bool, error)
+}
+
+type openAIStickySuccessKey struct{}
+
+type openAIStickySuccessState struct {
+	mu              sync.Mutex
+	groupID         int64
+	sessionHash     string
+	originalAccount int64
+	version         string
+	pendingAccount  int64
+	pending         bool
+	conflicted      bool
+	readErr         error
+}
+
+// WithOpenAIStickySuccess 将本请求的候选号留在上下文中，只有成功结果才能修改全局粘性。
+func (s *OpenAIGatewayService) WithOpenAIStickySuccess(ctx context.Context, groupID *int64, sessionHash string) context.Context {
+	if s == nil || s.cache == nil || sessionHash == "" || ctx == nil {
+		return ctx
+	}
+	if openAIStickySuccessFromContext(ctx, groupID, sessionHash) != nil {
+		return ctx
+	}
+	state := &openAIStickySuccessState{groupID: derefGroupID(groupID), sessionHash: sessionHash}
+	cache, ok := s.cache.(OpenAIStickySuccessCache)
+	if !ok {
+		state.readErr = errors.New("sticky cache does not support atomic success binding")
+	} else {
+		state.originalAccount, state.version, state.readErr = cache.GetOpenAIStickySnapshot(ctx, state.groupID, s.openAISessionCacheKey(sessionHash))
+		// 旧哈希只参与读取兼容；提交仍以新哈希原子快照为准。
+		if state.readErr == nil && state.originalAccount == 0 {
+			if accountID, err := s.getStickySessionAccountID(ctx, groupID, sessionHash); err == nil && accountID > 0 {
+				state.pendingAccount, state.pending = accountID, true
+			}
+		}
+	}
+	return context.WithValue(ctx, openAIStickySuccessKey{}, state)
+}
+
+func openAIStickySuccessFromContext(ctx context.Context, groupID *int64, sessionHash string) *openAIStickySuccessState {
+	if ctx == nil {
+		return nil
+	}
+	state, _ := ctx.Value(openAIStickySuccessKey{}).(*openAIStickySuccessState)
+	if state == nil || state.groupID != derefGroupID(groupID) || state.sessionHash != sessionHash {
+		return nil
+	}
+	return state
+}
+
+// PrepareOpenAIStickyAttempt 保留本次准入账号供同号重试，失败候选不会污染其他请求。
+func (s *OpenAIGatewayService) PrepareOpenAIStickyAttempt(ctx context.Context, groupID *int64, sessionHash string, accountID int64) {
+	if state := openAIStickySuccessFromContext(ctx, groupID, sessionHash); state != nil {
+		state.mu.Lock()
+		state.pendingAccount, state.pending = accountID, true
+		state.mu.Unlock()
+	}
+}
+
+// CommitOpenAIStickySuccess 只在完整成功后提交；版本冲突表示已有成功请求更新绑定，禁止回切。
+func (s *OpenAIGatewayService) CommitOpenAIStickySuccess(ctx context.Context, groupID *int64, sessionHash string, accountID int64) error {
+	state := openAIStickySuccessFromContext(ctx, groupID, sessionHash)
+	if state == nil || accountID <= 0 || preserveOpenAIGuardianParentBinding(ctx, sessionHash) {
+		return nil
+	}
+	state.mu.Lock()
+	defer state.mu.Unlock()
+	if state.readErr != nil {
+		return state.readErr
+	}
+	if state.conflicted {
+		return nil
+	}
+	cache, ok := s.cache.(OpenAIStickySuccessCache)
+	if !ok {
+		return errors.New("sticky cache does not support atomic success binding")
+	}
+	ttl := s.openAIWSSessionStickyTTL()
+	legacyKey := ""
+	if s.openAISessionHashDualWriteOldEnabled() {
+		legacyKey = s.openAILegacySessionCacheKey(ctx, sessionHash)
+	}
+	version, committed, err := cache.CommitOpenAIStickySuccess(ctx, state.groupID, s.openAISessionCacheKey(sessionHash), state.originalAccount, state.version, accountID, ttl, legacyKey, s.openAIStickyLegacyTTL(ttl))
+	if err != nil {
+		return err
+	}
+	if !committed {
+		state.conflicted = true
+		return nil
+	}
+	state.originalAccount, state.version = accountID, version
+	state.pendingAccount, state.pending = accountID, true
+	s.commitOpenAIEncryptedAcceptance(ctx, accountID)
+	return nil
+}
diff --git a/sub2api/backend/internal/service/openai_sticky_success_test.go b/sub2api/backend/internal/service/openai_sticky_success_test.go
new file mode 100644
index 0000000..8d2620c
--- /dev/null
+++ b/sub2api/backend/internal/service/openai_sticky_success_test.go
@@ -0,0 +1,79 @@
+package service
+
+import (
+	"context"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+type stickySuccessTestCache struct {
+	stubGatewayCache
+	mu      sync.Mutex
+	version int
+}
+
+func (c *stickySuccessTestCache) GetOpenAIStickySnapshot(_ context.Context, _ int64, key string) (int64, string, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.sessionBindings[key], strconv.Itoa(c.version), nil
+}
+
+func (c *stickySuccessTestCache) CommitOpenAIStickySuccess(_ context.Context, _ int64, key string, oldID int64, oldVersion string, accountID int64, _ time.Duration, legacyKey string, _ time.Duration) (string, bool, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.sessionBindings[key] != oldID || strconv.Itoa(c.version) != oldVersion {
+		return "", false, nil
+	}
+	c.version++
+	c.sessionBindings[key] = accountID
+	if legacyKey != "" {
+		c.sessionBindings[legacyKey] = accountID
+	}
+	return strconv.Itoa(c.version), true, nil
+}
+
+func TestOpenAIStickySuccessDefersCandidatesAndPersistsOnlySuccess(t *testing.T) {
+	cache := &stickySuccessTestCache{stubGatewayCache: stubGatewayCache{sessionBindings: map[string]int64{"openai:session": 1}}}
+	svc := &OpenAIGatewayService{cache: cache}
+	ctx := svc.WithOpenAIStickySuccess(context.Background(), nil, "session")
+	require.NoError(t, svc.deleteStickySessionAccountID(ctx, nil, "session"))
+	require.NoError(t, svc.BindStickySession(ctx, nil, "session", 2))
+	require.Equal(t, int64(1), cache.sessionBindings["openai:session"], "失败候选和临时删除不得修改全局绑定")
+	selected, err := svc.getStickySessionAccountID(ctx, nil, "session")
+	require.NoError(t, err)
+	require.Equal(t, int64(2), selected, "同请求重试可读到本次候选号")
+	require.NoError(t, svc.BindStickySession(ctx, nil, "session", 3))
+	require.NoError(t, svc.CommitOpenAIStickySuccess(ctx, nil, "session", 3))
+	require.Equal(t, int64(3), cache.sessionBindings["openai:session"])
+	next := svc.WithOpenAIStickySuccess(context.Background(), nil, "session")
+	selected, err = svc.getStickySessionAccountID(next, nil, "session")
+	require.NoError(t, err)
+	require.Equal(t, int64(3), selected, "下一轮沿用成功备用，不回切旧号")
+}
+
+func TestOpenAIStickySuccessLateOldRequestCannotReplaceSuccessfulSwitch(t *testing.T) {
+	cache := &stickySuccessTestCache{stubGatewayCache: stubGatewayCache{sessionBindings: map[string]int64{"openai:session": 1}}}
+	svc := &OpenAIGatewayService{cache: cache}
+	old := svc.WithOpenAIStickySuccess(context.Background(), nil, "session")
+	newer := svc.WithOpenAIStickySuccess(context.Background(), nil, "session")
+	require.NoError(t, svc.CommitOpenAIStickySuccess(newer, nil, "session", 2))
+	require.NoError(t, svc.CommitOpenAIStickySuccess(old, nil, "session", 1))
+	require.Equal(t, int64(2), cache.sessionBindings["openai:session"], "旧请求晚完成不得覆盖新成功绑定")
+	// 长连接每轮成功可以续期；冲突连接此后的成功也不能抢回绑定。
+	require.NoError(t, svc.CommitOpenAIStickySuccess(newer, nil, "session", 2))
+	require.NoError(t, svc.CommitOpenAIStickySuccess(old, nil, "session", 1))
+	require.Equal(t, int64(2), cache.sessionBindings["openai:session"])
+}
+
+func TestOpenAIStickySuccessUnsupportedCacheFailsClosed(t *testing.T) {
+	cache := &stubGatewayCache{sessionBindings: map[string]int64{"openai:session": 1}}
+	svc := &OpenAIGatewayService{cache: cache}
+	ctx := svc.WithOpenAIStickySuccess(context.Background(), nil, "session")
+	require.NoError(t, svc.BindStickySession(ctx, nil, "session", 2))
+	require.ErrorContains(t, svc.CommitOpenAIStickySuccess(ctx, nil, "session", 2), "atomic success binding")
+	require.Equal(t, int64(1), cache.sessionBindings["openai:session"], "缺少原子接口不能降级为无保护写入")
+}
