+package repository
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/alicebob/miniredis/v2"
+	"github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/require"
+)
+
+func TestOpenAIStickySuccessCASAndLocalToolWait(t *testing.T) {
+	server := miniredis.RunT(t)
+	client := redis.NewClient(&redis.Options{Addr: server.Addr()})
+	t.Cleanup(func() { _ = client.Close() })
+	cache := &gatewayCache{rdb: client}
+	ctx := context.Background()
+	const groupID int64 = 32
+	const key = "openai:session"
+	require.NoError(t, cache.SetSessionAccountID(ctx, groupID, key, 1, time.Hour))
+	oldID, oldVersion, err := cache.GetOpenAIStickySnapshot(ctx, groupID, key)
+	require.NoError(t, err)
+	require.Equal(t, int64(1), oldID)
+	newVersion, committed, err := cache.CommitOpenAIStickySuccess(ctx, groupID, key, oldID, oldVersion, 2, time.Hour, "openai:legacy", 10*time.Minute)
+	require.NoError(t, err)
+	require.True(t, committed)
+	require.NotEmpty(t, newVersion)
+	_, committed, err = cache.CommitOpenAIStickySuccess(ctx, groupID, key, oldID, oldVersion, 1, time.Hour, "openai:legacy", 10*time.Minute)
+	require.NoError(t, err)
+	require.False(t, committed, "旧完成无法回切，也不能覆盖旧哈希兼容绑定")
+	legacyID, err := cache.GetSessionAccountID(ctx, groupID, "openai:legacy")
+	require.NoError(t, err)
+	require.Equal(t, int64(2), legacyID)
+
+	server.FastForward(15 * time.Minute)
+	id, version, err := cache.GetOpenAIStickySnapshot(ctx, groupID, key)
+	require.NoError(t, err)
+	require.Equal(t, int64(2), id, "本地脚本等待15分钟后绑定仍存在")
+	require.Equal(t, newVersion, version)
+	require.NoError(t, cache.RefreshSessionTTL(ctx, groupID, key, time.Hour))
+	server.FastForward(50 * time.Minute)
+	id, version, err = cache.GetOpenAIStickySnapshot(ctx, groupID, key)
+	require.NoError(t, err)
+	require.Equal(t, int64(2), id)
+	require.Equal(t, newVersion, version, "续期后账号与版本同时存活")
+	_, committed, err = cache.CommitOpenAIStickySuccess(ctx, groupID, key, id, version, 2, time.Hour, "", 0)
+	require.NoError(t, err)
+	require.True(t, committed)
+}
+
+func TestOpenAIStickySuccessVersionRejectsABA(t *testing.T) {
+	server := miniredis.RunT(t)
+	client := redis.NewClient(&redis.Options{Addr: server.Addr()})
+	t.Cleanup(func() { _ = client.Close() })
+	cache := &gatewayCache{rdb: client}
+	ctx := context.Background()
+	const key = "openai:session"
+	require.NoError(t, cache.SetSessionAccountID(ctx, 32, key, 1, time.Hour))
+	oldID, oldVersion, err := cache.GetOpenAIStickySnapshot(ctx, 32, key)
+	require.NoError(t, err)
+	version2, ok, err := cache.CommitOpenAIStickySuccess(ctx, 32, key, oldID, oldVersion, 2, time.Hour, "", 0)
+	require.NoError(t, err)
+	require.True(t, ok)
+	_, ok, err = cache.CommitOpenAIStickySuccess(ctx, 32, key, 2, version2, 1, time.Hour, "", 0)
+	require.NoError(t, err)
+	require.True(t, ok)
+	_, ok, err = cache.CommitOpenAIStickySuccess(ctx, 32, key, oldID, oldVersion, 3, time.Hour, "", 0)
+	require.NoError(t, err)
+	require.False(t, ok, "账号值相同也必须检查版本，防止跨轮旧请求覆盖")
+}
