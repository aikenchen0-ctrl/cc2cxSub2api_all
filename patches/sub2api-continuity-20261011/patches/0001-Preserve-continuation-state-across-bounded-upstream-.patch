@@ -0,0 +1,60 @@
+package repository
+
+import (
+	"context"
+	"fmt"
+	"strconv"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/redis/go-redis/v9"
+)
+
+// 原账号键继续保存整数；版本键仅用于并发成功提交，不引入数据库迁移。
+var getOpenAIStickySnapshotScript = redis.NewScript(`
+return {redis.call('GET', KEYS[1]) or '0', redis.call('GET', KEYS[2]) or ''}
+`)
+
+var commitOpenAIStickySuccessScript = redis.NewScript(`
+local account = redis.call('GET', KEYS[1]) or '0'
+local version = redis.call('GET', KEYS[2]) or ''
+if account ~= ARGV[1] or version ~= ARGV[2] then
+  return 0
+end
+redis.call('SET', KEYS[1], ARGV[3], 'PX', ARGV[4])
+redis.call('SET', KEYS[2], ARGV[5], 'PX', ARGV[4])
+if #KEYS > 2 then
+  redis.call('SET', KEYS[3], ARGV[3], 'PX', ARGV[6])
+end
+return 1
+`)
+
+func (c *gatewayCache) GetOpenAIStickySnapshot(ctx context.Context, groupID int64, sessionHash string) (int64, string, error) {
+	key := buildSessionKey(groupID, sessionHash)
+	values, err := getOpenAIStickySnapshotScript.Run(ctx, c.rdb, []string{key, key + ":success_version"}).Slice()
+	if err != nil {
+		return 0, "", err
+	}
+	if len(values) != 2 {
+		return 0, "", fmt.Errorf("invalid sticky snapshot response")
+	}
+	accountID, err := strconv.ParseInt(fmt.Sprint(values[0]), 10, 64)
+	return accountID, fmt.Sprint(values[1]), err
+}
+
+func (c *gatewayCache) CommitOpenAIStickySuccess(ctx context.Context, groupID int64, sessionHash string, previousAccountID int64, previousVersion string, accountID int64, ttl time.Duration, legacyHash string, legacyTTL time.Duration) (string, bool, error) {
+	if accountID <= 0 || ttl <= 0 {
+		return "", false, fmt.Errorf("invalid sticky success binding")
+	}
+	key := buildSessionKey(groupID, sessionHash)
+	keys := []string{key, key + ":success_version"}
+	if legacyHash != "" {
+		if legacyTTL <= 0 {
+			return "", false, fmt.Errorf("invalid legacy sticky TTL")
+		}
+		keys = append(keys, buildSessionKey(groupID, legacyHash))
+	}
+	version := uuid.NewString()
+	result, err := commitOpenAIStickySuccessScript.Run(ctx, c.rdb, keys, previousAccountID, previousVersion, accountID, ttl.Milliseconds(), version, legacyTTL.Milliseconds()).Int()
+	return version, result == 1, err
+}
