+package repository
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/alicebob/miniredis/v2"
+	"github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/require"
+)
+
+func TestEncryptedRecoveryPersistsAcrossInstancesAndIsolatesTargets(t *testing.T) {
+	server := miniredis.RunT(t)
+	client := redis.NewClient(&redis.Options{Addr: server.Addr()})
+	t.Cleanup(func() { _ = client.Close() })
+	first := NewGatewayCache(client).(service.OpenAIEncryptedRecoveryCache)
+	ctx := context.Background()
+	digests := make([]string, 300)
+	for index := range digests {
+		digests[index] = fmt.Sprintf("digest_%d", index)
+	}
+	require.NoError(t, first.SetOpenAIEncryptedRecovery(ctx, 8, 9, "target_a", digests, 48*time.Hour))
+	second := NewGatewayCache(client).(service.OpenAIEncryptedRecoveryCache)
+	for _, scope := range []struct {
+		group, key int64
+		target     string
+	}{
+		{8, 10, "target_a"}, {7, 9, "target_a"}, {8, 9, "target_b"},
+	} {
+		got, err := second.GetOpenAIEncryptedRecovery(ctx, scope.group, scope.key, scope.target, digests)
+		require.NoError(t, err)
+		require.Empty(t, got)
+	}
+	got, err := second.GetOpenAIEncryptedRecovery(ctx, 8, 9, "target_a", append(digests, "new_cipher"))
+	require.NoError(t, err)
+	require.Len(t, got, 300)
+	require.NotContains(t, got, "new_cipher")
+	server.FastForward(49 * time.Hour)
+	got, err = second.GetOpenAIEncryptedRecovery(ctx, 8, 9, "target_a", digests)
+	require.NoError(t, err)
+	require.Empty(t, got)
+}
