--- /dev/null
+++ b/sub2api/backend/internal/repository/gateway_cache_encrypted_recovery.go
@@ -0,0 +1,78 @@
+package repository
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/redis/go-redis/v9"
+)
+
+func encryptedRecoveryKey(groupID, keyID int64) string {
+	return fmt.Sprintf("openai_encrypted_recovery:v1:%d:%d", groupID, keyID)
+}
+
+// 每个客户与分组最多保存16384项；读写均有批次上限，过期状态不视为许可。
+var encryptedRecoveryRead = redis.NewScript(`
+local result = {}
+for i=4,#ARGV do
+  local member = ARGV[3] .. ':' .. ARGV[i]
+  local expiry = redis.call('ZSCORE', KEYS[1], member)
+  if expiry and tonumber(expiry) > tonumber(ARGV[1]) then
+    redis.call('ZADD', KEYS[1], ARGV[2], member)
+    table.insert(result, ARGV[i])
+  end
+end
+if #result > 0 then redis.call('PEXPIRE', KEYS[1], ARGV[2]-ARGV[1]) end
+return result
+`)
+
+var encryptedRecoveryWrite = redis.NewScript(`
+redis.call('ZREMRANGEBYSCORE', KEYS[1], '-inf', ARGV[1])
+for i=4,#ARGV do redis.call('ZADD', KEYS[1], ARGV[2], ARGV[3] .. ':' .. ARGV[i]) end
+local excess = redis.call('ZCARD', KEYS[1]) - 16384
+if excess > 0 then redis.call('ZREMRANGEBYRANK', KEYS[1], 0, excess-1) end
+redis.call('PEXPIRE', KEYS[1], ARGV[2]-ARGV[1])
+return 1
+`)
+
+func (c *gatewayCache) GetOpenAIEncryptedRecovery(ctx context.Context, groupID, keyID int64, target string, digests []string) (map[string]struct{}, error) {
+	result := make(map[string]struct{})
+	if keyID <= 0 || target == "" {
+		return result, nil
+	}
+	for start := 0; start < len(digests); start += 128 {
+		end := min(start+128, len(digests))
+		now := time.Now()
+		args := []any{now.UnixMilli(), now.Add(48 * time.Hour).UnixMilli(), target}
+		for _, digest := range digests[start:end] {
+			args = append(args, digest)
+		}
+		values, err := encryptedRecoveryRead.Run(ctx, c.rdb, []string{encryptedRecoveryKey(groupID, keyID)}, args...).StringSlice()
+		if err != nil {
+			return nil, err
+		}
+		for _, digest := range values {
+			result[digest] = struct{}{}
+		}
+	}
+	return result, nil
+}
+
+func (c *gatewayCache) SetOpenAIEncryptedRecovery(ctx context.Context, groupID, keyID int64, target string, digests []string, ttl time.Duration) error {
+	if keyID <= 0 || target == "" || ttl <= 0 {
+		return nil
+	}
+	for start := 0; start < len(digests); start += 128 {
+		end := min(start+128, len(digests))
+		now := time.Now()
+		args := []any{now.UnixMilli(), now.Add(ttl).UnixMilli(), target}
+		for _, digest := range digests[start:end] {
+			args = append(args, digest)
+		}
+		if _, err := encryptedRecoveryWrite.Run(ctx, c.rdb, []string{encryptedRecoveryKey(groupID, keyID)}, args...).Result(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
