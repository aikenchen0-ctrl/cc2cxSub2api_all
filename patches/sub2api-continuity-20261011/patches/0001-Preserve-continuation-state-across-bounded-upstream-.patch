+
+func TestEncryptedRecoveryRequiresUnambiguousRejectedItem(t *testing.T) {
+	body := []byte(`{"input":[{"role":"user","content":"continue"},{"type":"reasoning","encrypted_content":"first"},{"type":"reasoning","encrypted_content":"second"}]}`)
+	for _, failure := range []string{
+		`{"error":{"code":"invalid_encrypted_content","message":"reasoning invalid"}}`,
+		`{"error":{"code":"invalid_encrypted_content","message":"Encrypted function output content could not be decrypted or decoded.","param":"input[1]"}}`,
+		`{"error":{"code":"invalid_encrypted_content","message":"reasoning invalid","param":"input[0]"}}`,
+	} {
+		require.Empty(t, openAIRejectedReasoningDigests(body, []byte(failure)))
+	}
+	for _, param := range []string{"input[1].encrypted_content", "input.1.encrypted_content", "input[1]"} {
+		got := openAIRejectedReasoningDigests(body, []byte(`{"error":{"code":"invalid_encrypted_content","message":"reasoning invalid","param":"`+param+`"}}`))
+		require.Equal(t, map[string]struct{}{openAIEncryptedContentDigest("first"): {}}, got)
+	}
+}
