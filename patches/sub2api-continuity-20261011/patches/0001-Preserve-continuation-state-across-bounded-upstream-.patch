+++ b/sub2api/backend/internal/handler/openai_sticky_success.go
@@ -0,0 +1,22 @@
+package handler
+
+import (
+	"context"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"go.uber.org/zap"
+)
+
+// 已交付后失败、客户端断开或缺少成功结果时，不把候选号提升为会话绑定。
+func (h *OpenAIGatewayHandler) commitOpenAIStickySuccess(ctx context.Context, groupID *int64, sessionHash string, accountID int64, result *service.OpenAIForwardResult, forwardErr error, reqLog *zap.Logger) {
+	if forwardErr != nil || result == nil || result.ClientDisconnect || !openAIForwardSucceededForScheduling(result) {
+		return
+	}
+	// 响应可能已结束，但提交仍有独立的短时限，避免 Redis 故障拖住请求清理。
+	commitCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), time.Second)
+	defer cancel()
+	if err := h.gatewayService.CommitOpenAIStickySuccess(commitCtx, groupID, sessionHash, accountID); err != nil {
+		reqLog.Warn("openai.sticky_success_commit_failed", zap.Int64("account_id", accountID), zap.Error(err))
+	}
+}
