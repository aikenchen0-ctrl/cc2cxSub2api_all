@@ -0,0 +1,151 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+)
+
+func TestEncryptedFailoverPreservesToolsAndSummary(t *testing.T) {
+	body := []byte(`{"model":"model","input":[{"role":"user","content":"run once"},{"type":"reasoning","id":"rs_1","encrypted_content":"opaque","summary":[{"type":"summary_text","text":"plan"}]},{"type":"function_call","call_id":"c1","name":"build","arguments":"{}"},{"type":"function_call_output","call_id":"c1","output":"done"}]}`)
+	before := string(body)
+	next, changed, err := prepareOpenAIEncryptedFailoverBody(body)
+	require.NoError(t, err)
+	require.True(t, changed)
+	require.Equal(t, before, string(body))
+	var original, updated map[string]any
+	require.NoError(t, json.Unmarshal(body, &original))
+	require.NoError(t, json.Unmarshal(next, &updated))
+	delete(original["input"].([]any)[1].(map[string]any), "encrypted_content")
+	require.Equal(t, original, updated)
+}
+
+func TestEncryptedFailoverRejectsOpaqueOrIncompleteHistory(t *testing.T) {
+	for _, body := range []string{
+		`{"input":[{"type":"compaction","encrypted_content":"secret"},{"role":"user","content":"next"}]}`,
+		`{"input":[{"type":"compaction_summary","encrypted_content":"secret"},{"role":"user","content":"next"}]}`,
+		`{"input":[{"type":"function_call_output","call_id":"c1","encrypted_content":"secret"},{"role":"user","content":"next"}]}`,
+		`{"previous_response_id":"resp_1","input":[{"type":"reasoning","encrypted_content":"secret"},{"role":"user","content":"next"}]}`,
+		`{"input":[{"type":"reasoning","encrypted_content":"secret"}]}`,
+	} {
+		next, changed, err := prepareOpenAIEncryptedFailoverBody([]byte(body))
+		require.Error(t, err)
+		require.False(t, changed)
+		require.Equal(t, body, string(next))
+	}
