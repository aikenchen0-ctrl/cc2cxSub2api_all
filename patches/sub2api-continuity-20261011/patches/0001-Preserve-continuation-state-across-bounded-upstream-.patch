+func TestOpenAIBoundedRetryClassifiesCompletedFailureOnly(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		status  int
+		elapsed time.Duration
+		body    string
+		request string
+		retry   bool
+	}{
+		{"fast_502", 502, time.Millisecond, `{"error":{"message":"unavailable"}}`, `{"input":"hello"}`, true},
+		{"fast_503", 503, time.Millisecond, `{"error":{"message":"unavailable"}}`, `{"messages":[{"role":"user","content":"hello"}]}`, true},
+		{"late_502", 502, 3 * time.Second, `{}`, `{"input":"hello"}`, false},
+		{"timeout_504", 504, time.Millisecond, `{}`, `{"input":"hello"}`, false},
+		{"rate_limit", 429, time.Millisecond, `{}`, `{"input":"hello"}`, false},
+		{"balance_wrapped_502", 502, time.Millisecond, `{"error":{"message":"insufficient balance"}}`, `{"input":"hello"}`, false},
+		{"plain_balance", 502, time.Millisecond, `insufficient balance`, `{"input":"hello"}`, false},
+		{"top_level_balance", 502, time.Millisecond, `{"code":"INSUFFICIENT_BALANCE","message":"Insufficient account balance"}`, `{"input":"hello"}`, false},
+		{"request_wrapped_502", 502, time.Millisecond, `{"error":{"type":"invalid_request_error"}}`, `{"input":"hello"}`, false},
+		{"policy_wrapped_503", 503, time.Millisecond, `{"error":{"code":"content_policy_violation"}}`, `{"input":"hello"}`, false},
+		{"echoed_user_input", 502, time.Millisecond, `{"error":{"message":"unavailable"},"input":"insufficient balance"}`, `{"input":"hello"}`, true},
+		{"model_wrapped_503", 503, time.Millisecond, `{"error":{"code":"model_not_found"}}`, `{"input":"hello"}`, false},
+		{"context_wrapped_502", 502, time.Millisecond, `{"error":{"code":"context_length_exceeded"}}`, `{"input":"hello"}`, false},
+		{"invalid_body", 502, time.Millisecond, `{}`, `broken`, false},
+		{"background", 502, time.Millisecond, `{}`, `{"input":"hello","background":true}`, false},
+		{"server_tool", 502, time.Millisecond, `{}`, `{"input":"hello","tools":[{"type":"computer"}]}`, false},
+		{"client_tool", 502, time.Millisecond, `{}`, `{"input":"hello","tools":[{"type":"function","name":"build"}]}`, true},
+		{"same_account_continuation", 502, time.Millisecond, `{}`, `{"previous_response_id":"resp_1","input":[{"type":"function_call_output","call_id":"call_1","output":"done"}]}`, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			gateway := &OpenAIGatewayService{}
+			account := fastFailoverPoolAccount()
+			failure := gateway.newOpenAIAccountFailoverError(account, tc.status, nil, []byte(tc.body), "", false, true)
+			failure = gateway.allowOpenAIBoundedSameAccountRetry(nil, account, "gpt-6-astra", failure, false, openAIUpstreamRetryAttempt{time.Now().Add(-tc.elapsed), []byte(tc.request)})
+			require.Equal(t, tc.retry, failure.OpenAIBoundedSameAccountRetry)
+			require.Equal(t, tc.retry, failure.RetryableOnSameAccount)
+			require.True(t, failure.SameAccountRetryDeadline.IsZero(), "故障分类不能创建新的推理截止时间")
+			if tc.retry {
+				require.Equal(t, 1, failure.SameAccountRetryMax)
+				require.GreaterOrEqual(t, failure.SameAccountRetryDelay, 200*time.Millisecond)
+				require.LessOrEqual(t, failure.SameAccountRetryDelay, 500*time.Millisecond)
+			}
+		})
+	}
+}
+
+func TestOpenAIBoundedRetryPreservesDeliveryAndCooldownBarriers(t *testing.T) {
+	for _, mode := range []string{"delivered", "retry_after", "model_cooldown", "account_cooldown", "disabled", "account_retry_zero", "missing_attempt", "client_canceled"} {
+		t.Run(mode, func(t *testing.T) {
+			gateway := &OpenAIGatewayService{}
+			account := fastFailoverPoolAccount()
+			c, _ := gin.CreateTestContext(httptest.NewRecorder())
+			c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+			failure := gateway.newOpenAIAccountFailoverError(account, 502, nil, []byte(`{}`), "", false, false)
+			attempt := openAIUpstreamRetryAttempt{time.Now(), []byte(`{"input":"hello"}`)}
+			disabled := false
+			switch mode {
+			case "delivered":
+				c.String(200, "tool_call")
+			case "retry_after":
+				failure.ResponseHeaders = http.Header{"Retry-After": []string{"120"}}
+			case "model_cooldown":
+				gateway.getOpenAIAccountModelTransientState().recordCooldown(account.ID, "gpt-6-astra", time.Now(), time.Now().Add(time.Minute))
+			case "account_cooldown":
+				gateway.BlockAccountScheduling(account, time.Now().Add(time.Minute), "test")
+			case "disabled":
+				disabled = true
+			case "account_retry_zero":
+				account.Credentials["pool_mode_retry_count"] = float64(0)
+			case "missing_attempt":
+				attempt.startedAt = time.Time{}
+			case "client_canceled":
+				ctx, cancel := context.WithCancel(context.Background())
+				cancel()
+				c.Request = c.Request.WithContext(ctx)
+			}
+			gateway.allowOpenAIBoundedSameAccountRetry(c, account, "gpt-6-astra", failure, disabled, attempt)
+			require.False(t, failure.RetryableOnSameAccount)
+			require.False(t, failure.OpenAIBoundedSameAccountRetry)
+		})
+	}
+}
+
+func TestOpenAIBoundedRetryKeepsModelFailureStreak(t *testing.T) {
+	repo := &errorPolicyRepoStub{}
+	gateway := &OpenAIGatewayService{rateLimitService: NewRateLimitService(repo, nil, &config.Config{}, nil, nil)}
+	account := fastFailoverPoolAccount()
