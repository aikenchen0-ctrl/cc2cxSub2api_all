+func TestAdaptiveFirstOutputWebSocketStartsEachTurnFresh(t *testing.T) {
+	var samples []time.Duration
+	conn := &openAIWSPassthroughFirstOutputFrameConn{
+		activeReadTimeout: time.Minute,
+		resolveDeadline: func([]byte) openAIWSPassthroughFirstOutputDeadline {
+			return openAIWSPassthroughFirstOutputDeadline{timeout: 5 * time.Minute, startedAt: time.Now()}
+		},
+		observeFirstOutput: func(deadline openAIWSPassthroughFirstOutputDeadline) {
+			samples = append(samples, time.Since(deadline.startedAt))
+		},
+	}
+	conn.armDeadline(nil)
+	conn.state.deadline.startedAt = time.Now().Add(-4 * time.Minute)
+	conn.observeUpstreamActivity(coderws.MessageText, []byte(`{"type":"response.created"}`))
+	require.Empty(t, samples)
+	conn.observeUpstreamActivity(coderws.MessageText, []byte(`{"type":"response.output_text.delta","delta":"ready"}`))
+	conn.observeUpstreamActivity(coderws.MessageText, []byte(`{"type":"response.completed"}`))
+	require.Len(t, samples, 1)
+	require.GreaterOrEqual(t, samples[0], 4*time.Minute)
+	require.False(t, conn.deadlineState().armed)
+	conn.armDeadline(nil)
+	conn.observeUpstreamActivity(coderws.MessageText, []byte(`{"type":"response.output_text.delta","delta":"next"}`))
+	require.Len(t, samples, 2)
