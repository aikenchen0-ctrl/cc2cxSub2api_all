+	c.Request.Body = io.NopCloser(strings.NewReader(body))
+	c.Request.ContentLength = int64(len(body))
+	serveTransparentFailover(h, c)
+	require.Equal(t, []int64{2}, upstream.calls(), rec.Body.String())
+	require.Equal(t, http.StatusOK, rec.Code)
+	require.Contains(t, string(upstream.bodies[0]), "encrypted_content")
+}
+
+func TestEncryptedContextRealHandlerFailover(t *testing.T) {
+	for _, opaque := range []bool{false, true} {
+		upstream := &transparentFailoverUpstream{failure: "http_429"}
+		h := newTransparentFailoverHandler(t, upstream, false, nil)
+		c, rec := transparentFailoverContext("/v1/responses")
+		item := `{"type":"reasoning","id":"rs1","encrypted_content":"opaque","summary":[{"type":"summary_text","text":"preserve-plan"}]}`
+		if opaque {
+			item = `{"type":"compaction","encrypted_content":"opaque"}`
+		}
+		body := `{"model":"test-model","stream":true,"input":[{"role":"user","content":"continue"},` + item + `]}`
+		c.Request.Body = io.NopCloser(strings.NewReader(body))
+		c.Request.ContentLength = int64(len(body))
+		serveTransparentFailover(h, c)
+		require.Equal(t, []int64{1, 2}, upstream.calls(), rec.Body.String())
+		require.Equal(t, http.StatusOK, rec.Code, rec.Body.String())
+		// 两个候选使用同一凭据，且缺少签发证据；不能仅凭编号变化破坏上下文。
+		require.True(t, gjson.GetBytes(upstream.bodies[0], "input.1.encrypted_content").Exists())
+		require.True(t, gjson.GetBytes(upstream.bodies[1], "input.1.encrypted_content").Exists())
+		if !opaque {
+			require.Equal(t, "preserve-plan", gjson.GetBytes(upstream.bodies[1], "input.1.summary.0.text").String())
+		}
+	}
+}
