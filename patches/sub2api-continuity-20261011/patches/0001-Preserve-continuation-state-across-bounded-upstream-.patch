diff --git a/sub2api/backend/internal/service/openai_adaptive_first_output.go b/sub2api/backend/internal/service/openai_adaptive_first_output.go
new file mode 100644
index 0000000..629592b
--- /dev/null
+++ b/sub2api/backend/internal/service/openai_adaptive_first_output.go
@@ -0,0 +1,191 @@
+package service
+
+import (
+	"crypto/sha256"
+	"net/http"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/tidwall/gjson"
+)
+
+const (
+	openAIFirstOutputSampleBuckets    = 256
+	openAIFirstOutputSamplesPerBucket = 64
+	openAIFirstOutputSampleTTL        = 30 * time.Minute
+	openAIFirstOutputMinimumSamples   = 8
+)
+
+type openAIFirstOutputSampleKey struct {
+	model  [sha256.Size]byte
+	effort string
+}
+
+type openAIFirstOutputResolvedTimeoutKey struct{}
+
+type openAIFirstOutputSample struct {
+	elapsed time.Duration
+	at      time.Time
+}
+
+type openAIFirstOutputSampleBucket struct {
+	samples  [openAIFirstOutputSamplesPerBucket]openAIFirstOutputSample
+	next     int
+	lastUsed time.Time
+}
+
+// 只保存首语义耗时，不保存请求正文、账号凭证或客户会话标识。
+// 模型键定长、桶数和样本数固定，避免客户端模型名造成无界内存增长。
+type openAIAdaptiveFirstOutputState struct {
+	mu      sync.Mutex
+	buckets map[openAIFirstOutputSampleKey]*openAIFirstOutputSampleBucket
+}
+
+func openAIFirstOutputEffortBucket(effort string) string {
+	switch effort = strings.ToLower(strings.TrimSpace(effort)); effort {
+	case "none", "minimal", "low", "medium", "high", "xhigh", "max":
+		return effort
+	default:
+		return "default"
+	}
+}
+
+func openAIFirstOutputBounds(effort string) (time.Duration, time.Duration) {
+	switch openAIFirstOutputEffortBucket(effort) {
+	case "high", "xhigh", "max":
+		// 冷启动给高推理档五分钟；学习只放宽，不因快速样本压缩安全等待。
+		return 300 * time.Second, 1800 * time.Second
+	default:
+		return 60 * time.Second, 600 * time.Second
+	}
+}
+
+func openAIFirstOutputKey(model, effort string) openAIFirstOutputSampleKey {
+	return openAIFirstOutputSampleKey{
+		model:  sha256.Sum256([]byte(strings.TrimSpace(model))),
+		effort: openAIFirstOutputEffortBucket(effort),
+	}
+}
+
+func openAIFirstOutputIsSuccessfulSemantic(data, eventType string) bool {
+	switch strings.TrimSpace(eventType) {
+	case "error", "response.failed", "response.incomplete", "response.cancelled", "response.canceled":
+		return false
+	case "response.completed", "response.done":
+		return openAIStreamDataStartsVisibleOutput(data, eventType)
+	}
+	if strings.HasSuffix(eventType, ".delta") {
+		return strings.TrimSpace(gjson.Get(data, "delta").String()) != ""
+	}
+	return openAIStreamDataStartsClientOutput(data, eventType)
+}
+
+func (s *OpenAIGatewayService) adaptiveOpenAIFirstOutputState() *openAIAdaptiveFirstOutputState {
+	if s == nil {
+		return nil
+	}
+	s.openaiFirstOutputOnce.Do(func() {
+		s.openaiFirstOutput = &openAIAdaptiveFirstOutputState{
+			buckets: make(map[openAIFirstOutputSampleKey]*openAIFirstOutputSampleBucket),
+		}
+	})
+	return s.openaiFirstOutput
+}
+
+func (s *OpenAIGatewayService) openAIFirstOutputTimeoutForRequest(account *Account, model, effort string) time.Duration {
+	if configured := s.openAIFirstOutputTimeout(effort); configured > 0 {
+		return configured
+	}
+	if account == nil || !account.ShouldFailoverImmediately(http.StatusBadGateway) {
+		return 0
+	}
+	return s.adaptiveOpenAIFirstOutputState().timeout(model, effort, time.Now())
+}
+
+// 调用方只在首次完整语义事件成功出现后反馈；错误、心跳和空前导不进入样本。
+// 工具执行发生在两轮请求之间，每次调用的 elapsed 都从本轮上游请求开始。
+func (s *OpenAIGatewayService) observeOpenAIFirstOutput(account *Account, model, effort string, elapsed time.Duration) {
+	if account == nil || !account.ShouldFailoverImmediately(http.StatusBadGateway) || elapsed < 0 {
+		return
+	}
+	// 系统时钟精度可能把本地立即返回记为零，仍是一条有效成功样本。
+	if elapsed == 0 {
+		elapsed = time.Nanosecond
+	}
+	s.adaptiveOpenAIFirstOutputState().observe(model, effort, elapsed, time.Now())
+}
+
+func (s *openAIAdaptiveFirstOutputState) timeout(model, effort string, now time.Time) time.Duration {
+	base, ceiling := openAIFirstOutputBounds(effort)
+	if s == nil {
+		return base
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	bucket := s.buckets[openAIFirstOutputKey(model, effort)]
+	if bucket == nil {
+		return base
+	}
+	bucket.lastUsed = now
+	var values [openAIFirstOutputSamplesPerBucket]time.Duration
+	count := 0
+	for _, sample := range bucket.samples {
+		if sample.elapsed > 0 && !sample.at.Before(now.Add(-openAIFirstOutputSampleTTL)) {
+			values[count] = sample.elapsed
+			count++
+		}
+	}
+	if count == 0 {
+		return base
+	}
+	sort.Slice(values[:count], func(i, j int) bool { return values[i] < values[j] })
+	index := count - 1
+	if count >= openAIFirstOutputMinimumSamples {
+		// 向上取整的 P95 另加一倍余量和十五秒抖动余量。
+		index = (count*95+99)/100 - 1
+	}
+	sample := values[index]
+	if sample >= (ceiling-15*time.Second)/2 {
+		return ceiling
+	}
+	if adaptive := sample*2 + 15*time.Second; adaptive > base {
+		return adaptive
+	}
+	return base
+}
+
+func (s *openAIAdaptiveFirstOutputState) observe(model, effort string, elapsed time.Duration, now time.Time) {
+	if s == nil || elapsed <= 0 {
+		return
+	}
+	_, ceiling := openAIFirstOutputBounds(effort)
+	if elapsed > ceiling {
+		elapsed = ceiling
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.buckets == nil {
+		s.buckets = make(map[openAIFirstOutputSampleKey]*openAIFirstOutputSampleBucket)
+	}
+	key := openAIFirstOutputKey(model, effort)
+	bucket := s.buckets[key]
+	if bucket == nil {
+		if len(s.buckets) >= openAIFirstOutputSampleBuckets {
+			var oldestKey openAIFirstOutputSampleKey
+			var oldestTime time.Time
+			for candidate, existing := range s.buckets {
+				if oldestTime.IsZero() || existing.lastUsed.Before(oldestTime) {
+					oldestKey, oldestTime = candidate, existing.lastUsed
+				}
+			}
+			delete(s.buckets, oldestKey)
+		}
+		bucket = &openAIFirstOutputSampleBucket{}
+		s.buckets[key] = bucket
+	}
+	bucket.samples[bucket.next] = openAIFirstOutputSample{elapsed: elapsed, at: now}
+	bucket.next = (bucket.next + 1) % len(bucket.samples)
+	bucket.lastUsed = now
+}
