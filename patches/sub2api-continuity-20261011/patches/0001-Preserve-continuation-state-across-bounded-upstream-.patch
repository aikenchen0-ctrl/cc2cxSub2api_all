@@ -0,0 +1,48 @@
+//go:build unit
+
+package handler
+
+import (
+	"fmt"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestContinuityHandlerTwoHundredConcurrentRequests(t *testing.T) {
+	const requests = 200
+	upstream := &transparentFailoverUpstream{delay: 25 * time.Millisecond}
+	h := newTransparentFailoverHandler(t, upstream, false, nil)
+	start := make(chan struct{})
+	errors := make(chan string, requests)
+	var workers sync.WaitGroup
+	for index := 0; index < requests; index++ {
+		workers.Add(1)
+		go func(index int) {
+			defer workers.Done()
+			c, recorder := transparentFailoverContext("/v1/responses")
+			c.Request.Header.Set("session-id", fmt.Sprintf("concurrent-session-%d", index))
+			<-start
+			serveTransparentFailover(h, c)
+			if recorder.Code != http.StatusOK || !strings.Contains(recorder.Body.String(), "response.completed") {
+				errors <- fmt.Sprintf("request=%d status=%d", index, recorder.Code)
+			}
+		}(index)
+	}
+	close(start)
+	workers.Wait()
+	close(errors)
+	for failure := range errors {
+		t.Error(failure)
+	}
+	require.Len(t, upstream.calls(), requests, "正常请求不得因并发而重复发送")
+	upstream.mu.Lock()
+	peak := upstream.peak
+	upstream.mu.Unlock()
+	require.Greater(t, peak, 8, "处理器不得引入全局八请求排队限制")
+	t.Logf("并发请求=%d，上游同时在途峰值=%d，成功=%d", requests, peak, requests)
+}
