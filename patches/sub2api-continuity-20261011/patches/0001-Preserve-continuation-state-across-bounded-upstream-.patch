+	digest := sha256.Sum256([]byte("opaque"))
+	identity := sha256.Sum256([]byte("openai\x00https://upstream.example.test\x00test-key\x00test-model"))
+	require.NoError(t, ownerCache.SetOpenAIEncryptedOwners(context.Background(), 3131, 99, []string{hex.EncodeToString(digest[:])}, service.OpenAIEncryptedOwner{AccountID: 2, Identity: hex.EncodeToString(identity[:])}, time.Hour))
+	upstream := &transparentFailoverUpstream{}
+	h := newTransparentFailoverHandler(t, upstream, false, nil, cache)
+	c, rec := transparentFailoverContext("/v1/responses")
