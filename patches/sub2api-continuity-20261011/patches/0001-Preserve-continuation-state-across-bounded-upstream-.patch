@@ -0,0 +1,50 @@
+package service
+
+import (
+	"context"
+	"time"
+)
+
+// 成功记录与拒绝记录共用有界摘要存储，以独立命名空间避免含义混淆。
+// 只有完整成功后的 CAS 赢家能写入；用于避免旧签发者把会话拉回故障账号。
+func (s *OpenAIGatewayService) commitOpenAIEncryptedAcceptance(ctx context.Context, accountID int64) {
+	state, _ := ctx.Value(openAIEncryptedAffinityKey{}).(*openAIEncryptedAffinity)
+	cache, ok := s.cache.(OpenAIEncryptedRecoveryCache)
+	if !ok || state == nil || state.keyID <= 0 || len(state.digests) == 0 {
+		return
+	}
+	workCtx, cancel := context.WithTimeout(ctx, 100*time.Millisecond)
+	defer cancel()
+	account, err := s.getSchedulableAccount(workCtx, accountID)
+	if err != nil || account == nil {
+		return
+	}
+	identity := openAIEncryptedIdentity(account, canonicalOpenAIAccountSchedulingModel(account, state.model))
+	_ = cache.SetOpenAIEncryptedRecovery(workCtx, state.groupID, state.keyID, "accepted:"+identity, state.digests, 48*time.Hour)
+}
+
+func (s *OpenAIGatewayService) acceptedEncryptedDigestsForSticky(ctx context.Context, state *openAIEncryptedAffinity, sessionHash string) map[string]struct{} {
+	cache, ok := s.cache.(OpenAIEncryptedRecoveryCache)
+	sticky := openAIStickySuccessFromContext(ctx, &state.groupID, sessionHash)
+	if !ok || sticky == nil || len(state.digests) == 0 {
+		return nil
+	}
+	sticky.mu.Lock()
+	accountID, version := sticky.originalAccount, sticky.version
+	sticky.mu.Unlock()
+	if accountID <= 0 || version == "" {
+		return nil
+	}
+	workCtx, cancel := context.WithTimeout(ctx, 100*time.Millisecond)
+	defer cancel()
+	account, err := s.getSchedulableAccount(workCtx, accountID)
+	if err != nil || account == nil {
+		return nil
+	}
+	identity := openAIEncryptedIdentity(account, canonicalOpenAIAccountSchedulingModel(account, state.model))
+	accepted, err := cache.GetOpenAIEncryptedRecovery(workCtx, state.groupID, state.keyID, "accepted:"+identity, state.digests)
+	if err != nil {
+		return nil
+	}
+	return accepted
+}
diff --git a/sub2api/backend/internal/service/openai_encrypted_affinity.go b/sub2api/backend/internal/service/openai_encrypted_affinity.go
new file mode 100644
index 0000000..80d28b2
--- /dev/null
+++ b/sub2api/backend/internal/service/openai_encrypted_affinity.go
@@ -0,0 +1,200 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"net/http"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/tidwall/gjson"
+)
+
+// OpenAIEncryptedOwner 只保存签发账号与单向指纹，绝不保存密钥或密文正文。
+type OpenAIEncryptedOwner struct {
+	AccountID int64  `json:"account_id"`
+	Identity  string `json:"identity"`
+	Digest    string `json:"-"`
+}
+
+type OpenAIEncryptedOwnerCache interface {
+	GetOpenAIEncryptedOwners(context.Context, int64, int64, []string) ([]OpenAIEncryptedOwner, error)
+	SetOpenAIEncryptedOwners(context.Context, int64, int64, []string, OpenAIEncryptedOwner, time.Duration) error
+}
+
+type openAIEncryptedAffinityKey struct{}
+type openAIEncryptedAffinity struct {
+	owner   *OpenAIEncryptedOwner
+	owners  map[string]OpenAIEncryptedOwner
+	groupID int64
+	keyID   int64
+	model   string
+	digests []string
+}
+
+const maxOpenAIEncryptedDigests = 16384
+
+func openAIEncryptedDigests(value gjson.Result) []string {
+	seen := make(map[string]struct{})
+	var visit func(gjson.Result, int)
+	visit = func(v gjson.Result, depth int) {
+		if depth > 32 || len(seen) >= maxOpenAIEncryptedDigests {
+			return
+		}
+		if v.IsObject() {
+			if encrypted := v.Get("encrypted_content"); encrypted.Type == gjson.String && encrypted.String() != "" {
+				seen[openAIEncryptedContentDigest(encrypted.String())] = struct{}{}
+			}
+		}
+		if v.IsObject() || v.IsArray() {
+			v.ForEach(func(_, child gjson.Result) bool { visit(child, depth+1); return len(seen) < maxOpenAIEncryptedDigests })
+		}
+	}
+	visit(value, 0)
+	out := make([]string, 0, len(seen))
+	for digest := range seen {
+		out = append(out, digest)
+	}
+	return out
+}
+
+func openAIEncryptedIdentity(account *Account, model string) string {
+	if account == nil {
+		return ""
+	}
+	value := account.Platform + "\x00" + account.GetCredential("base_url") + "\x00" + account.GetCredential("api_key") + "\x00" + model
+	hash := sha256.Sum256([]byte(value))
+	return hex.EncodeToString(hash[:])
+}
+
+// WithOpenAIEncryptedAffinity 只查询请求副本的密文摘要，不改历史文件或客户端字段。
+func (s *OpenAIGatewayService) WithOpenAIEncryptedAffinity(ctx context.Context, c *gin.Context, body []byte) context.Context {
+	if s == nil || c == nil || (!bytes.Contains(body, []byte(`"encrypted_content"`)) && gjson.GetBytes(body, "previous_response_id").String() == "") {
+		if ctx != nil && ctx.Value(openAIEncryptedAffinityKey{}) != nil {
+			return context.WithValue(ctx, openAIEncryptedAffinityKey{}, (*openAIEncryptedAffinity)(nil))
+		}
+		return ctx
+	}
+	state := &openAIEncryptedAffinity{owners: make(map[string]OpenAIEncryptedOwner),
+		groupID: getOpenAIGroupIDFromContext(c), keyID: getAPIKeyIDFromContext(c),
+		model: gjson.GetBytes(body, "model").String(), digests: openAIEncryptedDigests(gjson.GetBytes(body, "input"))}
+	if cache, ok := s.cache.(OpenAIEncryptedOwnerCache); ok {
+		lookupCtx, cancel := context.WithTimeout(ctx, 100*time.Millisecond)
+		owners, err := cache.GetOpenAIEncryptedOwners(lookupCtx, state.groupID, state.keyID, state.digests)
+		cancel()
+		if err == nil {
+			accepted := s.acceptedEncryptedDigestsForSticky(ctx, state, s.GenerateSessionHash(c, body))
+			mixed := false
+			for _, owner := range owners {
+				if owner.AccountID <= 0 {
+					continue
+				}
+				if owner.Digest != "" {
+					state.owners[owner.Digest] = owner
+				}
+				if _, alreadyAccepted := accepted[owner.Digest]; alreadyAccepted {
+					continue
+				}
+				if state.owner != nil && (state.owner.AccountID != owner.AccountID || state.owner.Identity != owner.Identity) {
+					mixed = true
+				}
+				copy := owner
+				state.owner = &copy
+			}
+			if mixed {
+				state.owner = nil
+			}
+		}
+	}
+	return context.WithValue(ctx, openAIEncryptedAffinityKey{}, state)
+}
+
+// observeOpenAIEncryptedOutput 在语义内容交付前记录签发者，不改写厂商密文格式。
+func (s *OpenAIGatewayService) observeOpenAIEncryptedOutput(ctx context.Context, c *gin.Context, account *Account, model string, body []byte) {
+	if !account.ShouldFailoverImmediately(http.StatusBadGateway) || c == nil || !bytes.Contains(body, []byte(`"encrypted_content"`)) {
+		return
+	}
+	cache, ok := s.cache.(OpenAIEncryptedOwnerCache)
+	if !ok {
+		return
+	}
+	root := gjson.ParseBytes(body)
+	var digests []string
+	for _, path := range []string{"item", "output", "response.output"} {
+		digests = append(digests, openAIEncryptedDigests(root.Get(path))...)
+	}
+	if len(digests) == 0 {
+		return
+	}
+	if len(digests) > maxOpenAIEncryptedDigests {
+		digests = digests[:maxOpenAIEncryptedDigests]
+	}
+	writeCtx, cancel := context.WithTimeout(ctx, 100*time.Millisecond)
+	defer cancel()
+	if err := cache.SetOpenAIEncryptedOwners(writeCtx, getOpenAIGroupIDFromContext(c), getAPIKeyIDFromContext(c), digests,
+		OpenAIEncryptedOwner{AccountID: account.ID, Identity: openAIEncryptedIdentity(account, model)}, s.openAIWSSessionStickyTTL()); err != nil {
+		slog.Warn("openai.encrypted_owner_write_failed", "account_id", account.ID)
+	}
+}
+
+// prepareOpenAIEncryptedAttempt 只应用目标上游已确认的恢复记录；选号变化本身不触发删除。
+func (s *OpenAIGatewayService) prepareOpenAIEncryptedAttempt(ctx context.Context, c *gin.Context, account *Account, body []byte) ([]byte, error) {
+	if account == nil || account.Platform != PlatformOpenAI || c == nil {
+		return body, nil
+	}
+	return s.prepareOpenAIEncryptedRecovery(ctx, c, account, body), nil
+}
+
+func prepareOpenAIEncryptedFailoverBody(body []byte) ([]byte, bool, error) {
+	invalid := make(map[string]struct{})
+	for _, digest := range collectOpenAIEncryptedContentDigestsRaw(body) {
+		invalid[digest] = struct{}{}
+	}
+	return prepareOpenAIEncryptedFailoverBodyForDigests(body, invalid)
+}
+
+func prepareOpenAIEncryptedFailoverBodyForDigests(body []byte, invalid map[string]struct{}) ([]byte, bool, error) {
+	safety := AnalyzeOpenAIContinuationSafety(body)
+	if !safety.CanStripEncryptedReasoning {
+		return body, false, fmt.Errorf("encrypted context is not independently replayable")
+	}
+	var request map[string]any
+	if err := decodeOpenAIJSONUseNumber(body, &request); err != nil {
+		return body, false, err
+	}
+	// 归属查询的数量上限不能变成清理上限；直接遍历当前输入项。
+	// 仅移除普通推理密文字段，保留编号、摘要、其他字段及全部工具结构。
+	changed := false
+	stripItem := func(value any) {
+		item, ok := value.(map[string]any)
+		if !ok || item["type"] != "reasoning" {
+			return
+		}
+		encrypted, ok := item["encrypted_content"].(string)
+		if ok && encrypted != "" {
+			if _, selected := invalid[openAIEncryptedContentDigest(encrypted)]; !selected {
+				return
+			}
+			delete(item, "encrypted_content")
+			changed = true
+		}
+	}
+	switch input := request["input"].(type) {
+	case []any:
+		for _, item := range input {
+			stripItem(item)
+		}
+	case map[string]any:
+		stripItem(input)
+	}
+	if !changed {
+		return body, false, nil
+	}
+	updated, err := json.Marshal(request)
+	return updated, err == nil, err
+}
