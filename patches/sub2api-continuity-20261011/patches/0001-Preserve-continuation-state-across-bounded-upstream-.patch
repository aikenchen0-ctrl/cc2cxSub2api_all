+	svc.cfg.Gateway.OpenAIHighEffortFirstOutputTimeoutSeconds = 120
+	require.Equal(t, 2*time.Minute, svc.openAIFirstOutputTimeoutForRequest(account, "model", "high"))
+	svc.cfg.Gateway.OpenAIFirstOutputTimeoutSeconds = 90
+	require.Equal(t, 90*time.Second, svc.openAIFirstOutputTimeoutForRequest(account, "model", "medium"))
