+func TestRateLimitService_HandleUpstreamError_FastFailoverPool403BalanceCodeOnlyAndScope(t *testing.T) {
+	body := []byte(`{"code":"INSUFFICIENT_BALANCE"}`)
+	h := newOpenAI403TestHarness(t, 314)
+	h.account.Type = AccountTypeAPIKey
+	h.account.Credentials = map[string]any{"pool_mode": true, "fast_failover": true}
+	require.Equal(t, ErrorPolicyNone, h.svc.CheckErrorPolicy(context.Background(), h.account, http.StatusForbidden, body))
+	require.True(t, h.handle(string(body)))
+	require.Equal(t, 1, h.repo.tempCalls)
+
+	for _, status := range []int{http.StatusBadRequest, http.StatusUnauthorized, http.StatusTooManyRequests} {
+		require.False(t, shouldApplyPoolModeOpenAI403HealthPolicy(h.account, status, body))
+	}
+	h.account.Platform = PlatformAnthropic
+	require.False(t, shouldApplyPoolModeOpenAI403HealthPolicy(h.account, http.StatusForbidden, body))
+	h.account.Platform, h.account.Type = PlatformOpenAI, AccountTypeOAuth
+	require.False(t, shouldApplyPoolModeOpenAI403HealthPolicy(h.account, http.StatusForbidden, body))
+	require.False(t, shouldApplyPoolModeOpenAI403HealthPolicy(nil, http.StatusForbidden, body))
+}
