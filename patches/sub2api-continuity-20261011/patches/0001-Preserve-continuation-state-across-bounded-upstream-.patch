@@ -0,0 +1,76 @@
+package service
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+)
+
+const anthropicCompletedHistory = `{"model":"claude-sonnet-4-5","thinking":{"type":"enabled","budget_tokens":2048},"tools":[{"name":"build","input_schema":{"type":"object"}}],"messages":[{"role":"user","content":"build"},{"role":"assistant","content":[{"type":"thinking","thinking":"check the actual build result","signature":"old"},{"type":"tool_use","id":"t1","name":"build","input":{"mode":"release"}}]},{"role":"user","content":[{"type":"tool_result","tool_use_id":"t1","content":"exit=1; compilation failed","is_error":true}]},{"role":"assistant","content":[{"type":"text","text":"the compilation failed"}]},{"role":"user","content":"explain the failure without building again"}]}`
+
+func TestAnthropicRecoveryKeepsCurrentThinkingAndToolSemantics(t *testing.T) {
+	body := []byte(anthropicCompletedHistory)
+	updated, changed := prepareAnthropicHistoryRecovery(body, "claude-sonnet-4-5", false)
+	require.True(t, changed)
+	require.Equal(t, anthropicCompletedHistory, string(body))
+	for _, path := range []string{"thinking", "tools", "messages.1.content.1", "messages.2", "messages.3", "messages.4"} {
+		require.JSONEq(t, gjson.GetBytes(body, path).Raw, gjson.GetBytes(updated, path).Raw)
+	}
+	require.Equal(t, "check the actual build result", gjson.GetBytes(updated, "messages.1.content.0.text").String())
+	require.False(t, gjson.GetBytes(updated, "messages.1.content.0.signature").Exists())
+	again, changed := prepareAnthropicHistoryRecovery(updated, "claude-sonnet-4-5", false)
+	require.False(t, changed)
+	require.Equal(t, updated, again)
+}
+
+func TestAnthropicHistoryTextFallbackPreservesCompleteOriginalRecords(t *testing.T) {
+	body := []byte(anthropicCompletedHistory)
+	updated, changed := prepareAnthropicHistoryRecovery(body, "claude-sonnet-4-5", true)
+	require.True(t, changed)
+	for _, path := range []string{"messages.1.content.1", "messages.2.content.0"} {
+		text := gjson.GetBytes(updated, path+".text").String()
+		require.Equal(t, "completed_tool_record", gjson.Get(text, "history_kind").String())
+		require.JSONEq(t, gjson.GetBytes(body, path).Raw, gjson.Get(text, "record").Raw)
+	}
+	require.JSONEq(t, gjson.GetBytes(body, "thinking").Raw, gjson.GetBytes(updated, "thinking").Raw)
+	require.JSONEq(t, gjson.GetBytes(body, "tools").Raw, gjson.GetBytes(updated, "tools").Raw)
+}
+
+func TestAnthropicRecoveryRejectsUnfinishedAndOpaqueState(t *testing.T) {
+	for _, variant := range []string{"current_tool_loop", "new_unfinished_loop", "new_result_without_final", "missing_result", "opaque_result", "redacted_thinking", "server_tool", "multimodal_result"} {
+		t.Run(variant, func(t *testing.T) {
+			var body map[string]any
+			require.NoError(t, json.Unmarshal([]byte(anthropicCompletedHistory), &body))
+			messages := body["messages"].([]any)
+			switch variant {
+			case "current_tool_loop":
+				body["messages"] = messages[:3]
+			case "new_unfinished_loop", "new_result_without_final":
+				messages = append(messages, map[string]any{"role": "assistant", "content": []any{map[string]any{"type": "tool_use", "id": "t2", "name": "build", "input": map[string]any{}}}})
+				if variant == "new_result_without_final" {
+					messages = append(messages, map[string]any{"role": "user", "content": []any{map[string]any{"type": "tool_result", "tool_use_id": "t2", "content": "done"}}})
+				}
+				body["messages"] = messages
+			case "missing_result":
+				body["messages"] = append(messages[:2], messages[3:]...)
+			case "opaque_result":
+				messages[2].(map[string]any)["content"].([]any)[0].(map[string]any)["encrypted_content"] = "opaque"
+			case "redacted_thinking":
+				messages[1].(map[string]any)["content"].([]any)[0] = map[string]any{"type": "redacted_thinking", "data": "opaque"}
+			case "server_tool":
+				messages[1].(map[string]any)["content"].([]any)[1].(map[string]any)["type"] = "server_tool_use"
+			case "multimodal_result":
+				messages[2].(map[string]any)["content"].([]any)[0].(map[string]any)["content"] = []any{map[string]any{"type": "image", "source": "remote"}}
+			}
+			original, err := json.Marshal(body)
+			require.NoError(t, err)
+			for _, toolsAsText := range []bool{false, true} {
+				updated, changed := prepareAnthropicHistoryRecovery(original, "claude-sonnet-4-5", toolsAsText)
+				require.False(t, changed)
+				require.Equal(t, original, updated)
+			}
+		})
+	}
+}
