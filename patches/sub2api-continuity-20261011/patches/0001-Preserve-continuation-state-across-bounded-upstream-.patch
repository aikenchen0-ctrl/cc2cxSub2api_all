+package service
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAnthropicBoundedRetrySharesRequestBudget(t *testing.T) {
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/messages", nil)
+	account := &Account{ID: 11, Platform: PlatformAnthropic, Type: AccountTypeAPIKey}
+	body := []byte(`{"messages":[{"role":"user","content":"hello"}],"tools":[{"name":"lookup","input_schema":{"type":"object"}}]}`)
+	response := &http.Response{StatusCode: http.StatusServiceUnavailable, Header: make(http.Header)}
+	require.True(t, allowAnthropicBoundedRetry(c, account, body, response, 1, time.Now()))
+	require.False(t, allowAnthropicBoundedRetry(c, account, body, response, 1, time.Now()))
+	require.False(t, allowAnthropicBoundedRetry(c, account, body, response, 2, time.Now()))
+}
+
+func TestAnthropicBoundedRetryRejectsLongRateLimitAndServerTools(t *testing.T) {
+	for _, test := range []struct {
+		status     int
+		age        time.Duration
+		retryAfter string
+		body       string
+	}{
+		{429, 0, "", `{"messages":[]}`},
+		{504, 0, "", `{"messages":[]}`},
+		{503, 3 * time.Second, "", `{"messages":[]}`},
+		{503, 0, "2", `{"messages":[]}`},
+		{503, 0, "", `{"messages":[],"tools":[{"type":"code_execution_20250825"}]}`},
+	} {
