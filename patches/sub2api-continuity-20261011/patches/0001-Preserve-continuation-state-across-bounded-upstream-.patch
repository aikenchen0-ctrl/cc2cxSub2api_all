+			&http.Response{StatusCode: 502}, []byte(`{"error":{"message":"unavailable"}}`), "unavailable", "upstream",
+			openAIUpstreamRetryAttempt{time.Now(), []byte(`{"input":"hello"}`)})
+		require.NotNil(t, failure)
+		require.Equal(t, attempt == 0, failure.RetryableOnSameAccount)
+	}
+	require.True(t, gateway.isOpenAIAccountModelRuntimeBlocked(account, "public"))
+	require.False(t, gateway.isOpenAIAccountModelRuntimeBlocked(account, "unrelated"))
+	require.False(t, gateway.isOpenAIAccountRuntimeBlocked(account))
+	require.Zero(t, repo.tempCalls)
+}
+
+func TestOpenAIBoundedTransportRetryRequiresUnsentDialFailure(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		err   error
+		retry bool
+	}{
+		{"dial", &net.OpError{Op: "dial", Net: "tcp", Err: errors.New("temporary network failure")}, true},
+		{"read", &net.OpError{Op: "read", Net: "tcp", Err: errors.New("temporary network failure")}, false},
