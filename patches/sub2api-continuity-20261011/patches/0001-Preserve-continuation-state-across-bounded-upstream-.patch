@@ -0,0 +1,42 @@
+package handler
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBoundedSameAccountRetryBudgetSurvivesRebuiltErrors(t *testing.T) {
+	account := &service.Account{ID: 744, Platform: service.PlatformOpenAI, Type: service.AccountTypeAPIKey,
+		Credentials: map[string]any{"fast_failover": true, "pool_mode": true, "pool_mode_retry_count": float64(5)}}
+	state := NewFailoverState(3, true)
+	unscheduler := &mockTempUnscheduler{}
+	for attempt := 0; attempt < 2; attempt++ {
+		// 每轮重建错误并故意提供新窗口，也不能刷新请求级一次预算。
+		failure := &service.UpstreamFailoverError{StatusCode: 502, RetryableOnSameAccount: true,
+			OpenAIBoundedSameAccountRetry: true, SameAccountRetryMax: 1,
+			SameAccountRetryDelay: time.Nanosecond, SameAccountRetryDeadline: time.Now().Add(time.Minute)}
+		limit := effectiveSameAccountRetryLimit(failure, account)
+		require.Equal(t, 1, limit)
+		require.Equal(t, FailoverContinue, state.HandleFailoverError(context.Background(), unscheduler, account.ID, account.Platform, limit, failure))
+		require.Equal(t, 1, state.SameAccountRetryCount[account.ID])
+		_, excluded := state.FailedAccountIDs[account.ID]
+		require.Equal(t, attempt == 1, excluded)
+		require.Equal(t, attempt, state.SwitchCount)
+		require.Equal(t, attempt == 1, state.ForceCacheBilling)
+	}
+	// 模型冷却已经由服务层记账，不升级为旧池模式的整账号临时禁用。
+	require.Empty(t, unscheduler.calls)
+}
+
+func TestBoundedSameAccountRetryRespectsDisabledBudget(t *testing.T) {
+	account := &service.Account{Platform: service.PlatformOpenAI, Type: service.AccountTypeAPIKey,
+		Credentials: map[string]any{"fast_failover": true, "pool_mode": true, "pool_mode_retry_count": float64(0)}}
+	failure := &service.UpstreamFailoverError{StatusCode: 503, RetryableOnSameAccount: true,
+		OpenAIBoundedSameAccountRetry: true, SameAccountRetryMax: 1}
+	require.Zero(t, effectiveSameAccountRetryLimit(failure, account))
+	require.False(t, sameAccountRetryAllowed(failure, 0, effectiveSameAccountRetryLimit(failure, account)))
+}
