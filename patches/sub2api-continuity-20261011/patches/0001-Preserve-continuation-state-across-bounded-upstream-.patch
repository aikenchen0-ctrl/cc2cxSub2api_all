new file mode 100644
index 0000000..d568917
--- /dev/null
+++ b/sub2api/backend/internal/service/anthropic_bounded_retry.go
@@ -0,0 +1,36 @@
+package service
+
+import (
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/tidwall/gjson"
+)
+
+func allowAnthropicBoundedRetry(c *gin.Context, account *Account, body []byte, response *http.Response, attempt int, started time.Time) bool {
+	if c == nil || account == nil || response == nil || attempt != 1 || time.Since(started) > 2*time.Second ||
+		(response.StatusCode != http.StatusBadGateway && response.StatusCode != http.StatusServiceUnavailable) ||
+		strings.TrimSpace(response.Header.Get("Retry-After")) != "" || accountPersistedSchedulingCooldownActive(account) || c.Writer.Written() {
+		return false
+	}
+	if c.Request != nil && c.Request.Context().Err() != nil {
+		return false
+	}
+	if !gjson.ValidBytes(body) || !gjson.GetBytes(body, "messages").IsArray() {
+		return false
+	}
+	for _, tool := range gjson.GetBytes(body, "tools").Array() {
+		// 原生用户工具默认没有 type；带服务端工具类型的不做自动重放。
+		if tool.Get("type").String() != "" && tool.Get("type").String() != "custom" {
+			return false
+		}
+	}
+	const usedKey = "anthropic_bounded_retry_used"
+	if c.GetBool(usedKey) {
+		return false
+	}
+	c.Set(usedKey, true)
+	return true
+}
