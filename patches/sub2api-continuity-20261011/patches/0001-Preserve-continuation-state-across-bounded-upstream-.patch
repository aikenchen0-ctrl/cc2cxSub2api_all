+)
+
+func TestOpenAIStickySuccessfulFailoverStaysOnNewAccount(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, path := range []string{"/v1/responses", "/v1/chat/completions", "/v1/messages"} {
+		t.Run(path, func(t *testing.T) {
+			server := miniredis.RunT(t)
+			client := redis.NewClient(&redis.Options{Addr: server.Addr()})
+			t.Cleanup(func() { _ = client.Close() })
+			cache := repository.NewGatewayCache(client)
+			ctx := context.Background()
+			key := "openai:" + service.DeriveSessionHashFromSeed("unchanged-client-session")
+			require.NoError(t, cache.SetSessionAccountID(ctx, 3131, key, 1, time.Hour))
+			upstream := &transparentFailoverUpstream{failure: "http_429"}
+			h := newTransparentFailoverHandler(t, upstream, false, nil, cache)
+			c, rec := transparentFailoverContext(path)
+			serveTransparentFailover(h, c)
+			require.Equal(t, http.StatusOK, rec.Code, rec.Body.String())
+			require.Contains(t, rec.Body.String(), "healthy-output")
+			require.Equal(t, []int64{1, 2}, upstream.calls())
+			id, err := cache.GetSessionAccountID(ctx, 3131, key)
+			require.NoError(t, err)
+			require.Equal(t, int64(2), id)
+			server.FastForward(15 * time.Minute)
+			c, rec = transparentFailoverContext(path)
+			serveTransparentFailover(h, c)
+			require.Equal(t, http.StatusOK, rec.Code, rec.Body.String())
+			require.Equal(t, []int64{1, 2, 2}, upstream.calls(), "恢复旧账号后下一轮仍应使用成功备用")
+		})
+	}
+}
+
+func TestOpenAIStickyFailedDeliveredOutputDoesNotCommit(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, path := range []string{"/v1/responses", "/v1/chat/completions", "/v1/messages"} {
+		t.Run(path, func(t *testing.T) {
+			server := miniredis.RunT(t)
+			client := redis.NewClient(&redis.Options{Addr: server.Addr()})
+			t.Cleanup(func() { _ = client.Close() })
+			cache := repository.NewGatewayCache(client)
+			key := "openai:" + service.DeriveSessionHashFromSeed("unchanged-client-session")
+			require.NoError(t, cache.SetSessionAccountID(context.Background(), 3131, key, 1, time.Hour))
+			upstream := &transparentFailoverUpstream{failure: "semantic_error"}
+			h := newTransparentFailoverHandler(t, upstream, false, nil, cache)
+			c, rec := transparentFailoverContext(path)
+			serveTransparentFailover(h, c)
+			require.Equal(t, []int64{1}, upstream.calls(), "已交付正文不能重放")
+			require.Contains(t, rec.Body.String(), "partial-output")
+			snapshot := cache.(service.OpenAIStickySuccessCache)
+			id, version, err := snapshot.GetOpenAIStickySnapshot(context.Background(), 3131, key)
+			require.NoError(t, err)
+			require.Equal(t, int64(1), id)
+			require.Empty(t, version, "失败响应不能生成成功绑定版本")
+		})
+	}
+}
+
+func TestOpenAIStickySuccessWSResultGuard(t *testing.T) {
+	// 真实 WS 转发另有协议回归；此处验证共享提交入口拒绝失败、断开与缺失结果。
+	h := &OpenAIGatewayHandler{}
+	for _, result := range []*service.OpenAIForwardResult{nil, {ClientDisconnect: true}, {OpenAIWSMode: true, UpstreamTerminalEvent: "response.failed"}} {
+		h.commitOpenAIStickySuccess(context.Background(), nil, "session", 1, result, nil, zap.NewNop())
+	}
+	h.commitOpenAIStickySuccess(context.Background(), nil, "session", 1, &service.OpenAIForwardResult{}, errors.New("upstream closed"), zap.NewNop())
+}
