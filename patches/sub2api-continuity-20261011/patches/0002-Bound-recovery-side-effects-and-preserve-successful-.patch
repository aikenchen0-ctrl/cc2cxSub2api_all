--- /dev/null
+++ b/sub2api/backend/internal/service/continuity_side_effects_test.go
@@ -0,0 +1,84 @@
+package service
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBoundedRetryBudgetDoesNotResetOnAccountSwitch(t *testing.T) {
+	service := &OpenAIGatewayService{}
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	for index, id := range []int64{101, 202, 303} {
+		account := &Account{ID: id, Platform: PlatformOpenAI, Type: AccountTypeAPIKey,
+			Credentials: map[string]any{"fast_failover": true, "pool_mode": true, "pool_mode_retry_count": 5}}
+		failure := &UpstreamFailoverError{StatusCode: 502}
+		service.allowOpenAIBoundedSameAccountRetry(c, account, "model", failure, false,
+			openAIUpstreamRetryAttempt{time.Now(), []byte(`{"input":"continue"}`)})
+		require.Equal(t, index == 0, failure.OpenAIBoundedSameAccountRetry)
+	}
+}
+
+func TestRecoveryBudgetSharedAndFieldsPreserved(t *testing.T) {
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	require.True(t, claimOpenAIEncryptedRecoveryRetry(c))
+	require.False(t, claimOpenAIEncryptedRecoveryRetry(c))
+	request := map[string]any{"input": []any{map[string]any{"type": "reasoning", "id": "r1", "summary": []any{}, "content": nil, "encrypted_content": "old"}}}
+	require.Equal(t, 1, stripOpenAIInvalidEncryptedContentItems(request, map[string]struct{}{openAIEncryptedContentDigest("old"): {}}))
+	item := request["input"].([]any)[0].(map[string]any)
+	require.Contains(t, item, "content", "清推理密文不能顺手清理其他字段")
+	require.Equal(t, "r1", item["id"])
+	require.Contains(t, item, "summary")
+}
+
+func TestPassthroughDisconnectIsNotAClientSuccess(t *testing.T) {
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Request = httptest.NewRequest(http.MethodPost, "/responses", nil)
+	c.Writer = &failWriteResponseWriter{ResponseWriter: c.Writer}
+	service := &OpenAIGatewayService{cfg: &config.Config{}}
+	response := &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": {"text/event-stream"}},
+		Body: io.NopCloser(strings.NewReader("data: {\"type\":\"response.output_text.delta\",\"delta\":\"hello\"}\n\ndata: {\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"output\":[]}}\n\n"))}
+	result, _ := service.handleStreamingResponsePassthrough(context.Background(), response, c, &Account{ID: 1}, time.Now(), "model", "model")
+	require.NotNil(t, result)
+	require.True(t, result.clientDisconnect, "上游完成但客户写入失败，不得提交客户成功亲和")
+}
+
+type recoveryCommitTestCache struct {
+	GatewayCache
+	writes int
+}
+
+func (c *recoveryCommitTestCache) GetOpenAIEncryptedRecovery(context.Context, int64, int64, string, []string) (map[string]struct{}, error) {
+	return nil, nil
+}
+
+func (c *recoveryCommitTestCache) SetOpenAIEncryptedRecovery(context.Context, int64, int64, string, []string, time.Duration) error {
+	c.writes++
+	return nil
+}
+
+func TestRejectedCipherIsNotPersistedUntilRecoveryCompletes(t *testing.T) {
+	cache := &recoveryCommitTestCache{}
+	service := &OpenAIGatewayService{cache: cache}
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Set("api_key", &APIKey{ID: 11})
+	c.Set(openAIEncryptedRecoveryScopeKey, openAIEncryptedRecoveryScope{accountID: 22, target: "target"})
+	body := []byte(`{"input":[{"role":"user","content":"continue"},{"type":"reasoning","encrypted_content":"old"}]}`)
+	service.rememberOpenAIEncryptedRecovery(c, body, 22)
+	require.Zero(t, cache.writes)
+	service.commitOpenAIEncryptedRecovery(c, 22, false)
+	service.commitOpenAIEncryptedRecovery(c, 33, true)
+	require.Zero(t, cache.writes)
+	service.commitOpenAIEncryptedRecovery(c, 22, true)
+	require.Equal(t, 1, cache.writes)
+	service.commitOpenAIEncryptedRecovery(c, 22, true)
+	require.Equal(t, 1, cache.writes)
+}
