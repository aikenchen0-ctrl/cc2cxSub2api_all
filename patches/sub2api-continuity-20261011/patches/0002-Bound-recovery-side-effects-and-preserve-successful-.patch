+
+func (s *OpenAIGatewayService) commitOpenAIEncryptedRecovery(c *gin.Context, accountID int64, success bool) {
+	if !success || s == nil || c == nil {
+		return
+	}
+	cache, ok := s.cache.(OpenAIEncryptedRecoveryCache)
+	if !ok {
+		return
+	}
+	value, _ := c.Get(openAIEncryptedRecoveryPendingKey)
+	pending, ok := value.(openAIEncryptedRecoveryPending)
+	if !ok || pending.accountID != accountID || pending.target == "" || len(pending.digests) == 0 {
+		return
+	}
 	ctx := context.Background()
 	if c.Request != nil {
 		ctx = c.Request.Context()
 	}
 	writeCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 100*time.Millisecond)
 	defer cancel()
-	// 两天内重复引用刷新摘要期限；不借此延长任何正文的保留时间。
-	if err := cache.SetOpenAIEncryptedRecovery(writeCtx, getOpenAIGroupIDFromContext(c), getAPIKeyIDFromContext(c), scope.target, digests, 48*time.Hour); err != nil {
+	// 固定两天有效期，读取不续期；不把长期坏请求变成永久删减许可。
+	if err := cache.SetOpenAIEncryptedRecovery(writeCtx, getOpenAIGroupIDFromContext(c), getAPIKeyIDFromContext(c), pending.target, pending.digests, 48*time.Hour); err != nil {
 		slog.Warn("openai.encrypted_recovery_write_failed", "account_id", accountID)
+	} else {
+		c.Set(openAIEncryptedRecoveryPendingKey, openAIEncryptedRecoveryPending{})
 	}
 }
