# Sub2API origin. LINK accepts localhost:18080 or a full URL.
LINK=localhost:18080
# Docker network name shared with Sub2API. For docker-compose.online.yml use
# sub2api-deploy_sub2api-network; the local deploy compose defaults below.
MODELAUDIT_SUB2API_NETWORK=deploy_sub2api-network
# Optional Docker-only origin, for example http://sub2api:8080/v1.
SUB2API_RELAY_BASE_URL=
SUB2API_ADMIN_BASE_URL=

# Server-side credentials only. Never put these in frontend configuration.
SUB2API_ADMIN_API_KEY=
# Optional fallback for an admin-only JWT if x-api-key is unavailable.
SUB2API_ADMIN_JWT=
# JSON maps Sub2API group IDs to ordinary gateway API keys, for example {"12":"sk-..."}.
# For deterministic per-account audits, use a group with exactly one active schedulable account.
SUB2API_GATEWAY_API_KEYS={}

# Public gateway profile per group, including tokenizer/cache protocol and an
# optional pricing_model key for the bundled LiteLLM price snapshot. Individual
# prices in `pricing` override the snapshot in USD per million tokens.
MODELAUDIT_GROUP_PROFILES={}

# SSO secret must match Sub2API and contain at least 32 bytes.
SUB2API_SSO_SECRET=
MODELAUDIT_SESSION_SECRET=
MODELAUDIT_COOKIE_SECURE=true
MODELAUDIT_ALLOWED_ORIGINS=

MODELAUDIT_DB_PATH=/app/data/modelaudit.sqlite3
MODELAUDIT_INTERVAL_MINUTES=60
MODELAUDIT_SCHEDULE_ENABLED=true
MODELAUDIT_RUN_ON_START=false
MODELAUDIT_MAX_GROUP_CALIBRATIONS=5
MODELAUDIT_MAX_PARALLEL_ACCOUNTS=4
MODELAUDIT_REQUEST_TIMEOUT_SECONDS=240
MODELAUDIT_AUTO_STOP_ENABLED=false
MODELAUDIT_MULTIPLIER_ORDER_OF_MAGNITUDE=10
MODELAUDIT_MODELTRACE_MIN_PROBABILITY=0.95
MODELAUDIT_MODELTRACE_MIN_PROFILE_SIMILARITY=0
MODELAUDIT_MODELTRACE_MIN_MARGIN=0.20
