+    // 直接从磁盘流式上传，避免完整正文及 JSON 序列化副本同时驻留内存。
+    pub async fn log_body_file(&self, app_state: &AppState, auth_ctx: &AuthContext,
+        request_id: Uuid, path: &std::path::Path) -> Result<(), LoggerError> {
+        use tokio::io::AsyncReadExt;
