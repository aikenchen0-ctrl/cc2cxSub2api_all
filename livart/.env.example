# 可选配置：不创建本文件也能直接 docker compose up -d --build 启动。
# 如果要公网部署，建议复制为 .env 并替换下面的默认口令。

LIVART_PORT=8080
SPRING_PROFILES_ACTIVE=prod
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
RABBITMQ_DEFAULT_USER=livart
RABBITMQ_DEFAULT_PASS=replace-with-strong-rabbitmq-password
MINIO_ROOT_USER=livartminio
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_BUCKET=livart
JWT_SECRET=replace-with-at-least-32-chars-secret
JWT_TTL_DAYS=3
MINIO_CONSOLE_PORT=9001
LOG_MAX_HISTORY=1
LOG_TOTAL_SIZE_CAP=200MB
RABBITMQ_LISTENER_CONCURRENCY=3
RABBITMQ_LISTENER_MAX_CONCURRENCY=6
RABBITMQ_LISTENER_PREFETCH=1

# 与 sub2api 共用的 SSO 密钥（至少 32 字符）。留空则无法从 sub2api 超级改图菜单免登录进入。
SUB2API_SSO_SECRET=

# 服务端默认 Sub2API 卫星中转。应用凭据只放在服务端，不要写入浏览器 URL。
LIVART_DEFAULT_API_BASE_URL=
LIVART_DEFAULT_API_KEY=
SUB2API_RELAY_BASE_URL=
SUB2API_APP_CREDENTIAL=
LIVART_DEFAULT_IMAGE_MODEL=gpt-image-2
LIVART_DEFAULT_CHAT_MODEL=gpt-5.4-mini
LIVART_KNOWLEDGE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LIVART_KNOWLEDGE_EMBEDDING_API_KEY=
LIVART_KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
LIVART_DEFAULT_IMAGE_SIZE_ENABLED=true
LIVART_DEFAULT_IMAGE_LONG_SIDE=2048
LIVART_IMAGE_JOB_WORKER_COUNT=16
LIVART_EXTERNAL_IMAGES_ENDPOINT=https://gogotool.top/api/v1/external/images
LIVART_EXTERNAL_IMAGES_API_KEY=
LIVART_EXTERNAL_IMAGES_TIMEOUT_SECONDS=45
