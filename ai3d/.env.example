TRIPO_API_KEY=your_tripo_api_key
LINK=localhost:18080
SUB2API_RELAY_BASE_URL=
# Required in managed deployments. Leave empty here so Compose fails closed
# until real values are supplied in the deployment environment.
SUB2API_SSO_SECRET=
SUB2API_APP_CREDENTIAL=
SUB2API_RELAY_MODEL=gpt-5.5
# Optional comma-separated browser origins for direct API access. Production
# serves the UI and API from one origin, so this is normally left empty.
CORS_ORIGIN=
AI3D_SSO_CALLBACK_URL=http://localhost:5174/api/auth/sso/callback
AI3D_AUTH_DB=.auth/sessions.json
# Standalone Vite development UI port. Production uses API_PORT for both.
VITE_PORT=5174
TRIPO_MODEL_VERSION=v3.0-20250812
TRIPO_API_BASE=https://api.tripo3d.ai/v2/openapi
RODIN_API_KEY=your_rodin_api_key
RODIN_API_BASE=https://api.hyper3d.com/api/v2
RODIN_TIER=Gen-2
RODIN_QUALITY=medium
RODIN_MESH_MODE=Raw
RODIN_MATERIAL=PBR
FAL_API_KEY=your_fal_api_key
FAL_DEFAULT_MODEL=fal-ai/hunyuan3d/v2
VISION_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-5.5
# Optional local Hunyuan3D service. Leave empty unless one is reachable from
# the AI3D container (127.0.0.1 would point back to this container).
HUNYUAN_API_BASE=
HUNYUAN_CREATE_PATH=/send
HUNYUAN_STATUS_PATH=/status
HUNYUAN_CLOUD_API_KEY=your_hunyuan_tokenhub_api_key
HUNYUAN_CLOUD_API_BASE=https://api.ai3d.cloud.tencent.com
HUNYUAN_CLOUD_SUBMIT_PATH=/v1/ai3d/submit
HUNYUAN_CLOUD_QUERY_PATH=/v1/ai3d/query
HUNYUAN_CLOUD_MODEL=3.0
HUNYUAN_CLOUD_GENERATE_TYPE=Sketch
HUNYUAN_CLOUD_ENABLE_PBR=true
HUNYUAN_CLOUD_FACE_COUNT=30000
API_PORT=8787
API_HOST=127.0.0.1
LOCAL_MODEL_DIR=.generated-models
LOG_DIR=.logs
LOG_FILE=3d-model-studio-api.log
