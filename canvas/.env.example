# 管理员账号，首次启动会自动创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=infinite-canvas

# JWT 登录密钥和过期时间，正式部署请修改 JWT_SECRET。
JWT_SECRET=infinite-canvas
JWT_EXPIRE_HOURS=72

# 后端默认监听 8080，如需本地开发修改端口再取消注释。
# Docker 镜像内前端固定监听 3000，避免覆盖前端 PORT。
# PORT=8080

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8080

# 数据库配置，默认使用本地 SQLite。
STORAGE_DRIVER=sqlite
# sqlite: DATABASE_DSN=data/infinite-canvas.db
# Docker 部署时建议使用绝对路径，避免工作目录变化后写入临时库：DATABASE_DSN=/app/data/infinite-canvas.db
# mysql 目标库不存在时会尝试自动创建，账号需有 CREATE 权限。
# mysql: DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/infinite_canvas?parseTime=true
# postgres 目标库不存在时会尝试自动创建，账号需有 CREATEDB 权限。
# postgres: DATABASE_DSN=postgres://user:password@127.0.0.1:5432/infinite_canvas?sslmode=disable
DATABASE_DSN=data/infinite-canvas.db

# Optional Sub2API relay. LINK or SUB2API_RELAY_BASE_URL plus SUB2API_APP_CREDENTIAL
# is enough for SSO users. Use the model gateway /v1, NOT the account API /api/v1.
# Docker: http://sub2api:8080/v1; host development: http://localhost:18080/v1.
LINK=localhost:18080
SUB2API_RELAY_BASE_URL=
SUB2API_APP_CREDENTIAL=
SUB2API_RELAY_MODELS=gpt-5.5
SUB2API_RELAY_IMAGE_MODELS=gpt-image-2,grok-imagine-image-1.5
SUB2API_RELAY_VIDEO_MODELS=grok-imagine-video-1.5,seedance-2.0,kling-v3
# Optional SSO: match the portal SUB2API_SSO_SECRET (at least 32 characters).
SUB2API_SSO_SECRET=
# For docker-compose.sub2api.yml, use the existing gateway Docker network name.
SUB2API_DOCKER_NETWORK=
