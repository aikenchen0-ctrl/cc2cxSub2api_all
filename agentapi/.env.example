# Compose interpolation values (the service secrets live in backend/.env).
# AgentAPI is one shared multi-tenant service, not one process per agent. Keep
# the repository local port aligned with 本地链接.txt and docker-compose.yml.
AGENTAPI_PORT=18081
# Must match the main Sub2API value. It is injected into the container only.
SUB2API_SSO_SECRET=
