# Main Sub2API origin. MAIN_API_URL may be the origin or end in /api/v1.
MAIN_API_URL=https://api.example.com
# Public main-site origin for recharge links; never set this to a Docker hostname.
# When omitted, the recharge button has no destination and stays disabled.
LINK=https://api.example.com
# Deployment-only Sub2API administrator API key for creating regular users.
# Missing key disables AgentAPI signup. Never distribute this to site owners
# or browsers; it is NOT the model relay credential. *_FILE is supported.
SUB2API_ADMIN_API_KEY=
# Legacy SUB2API_ADMIN_KEY is accepted when the new name is absent.
# A configured unreadable *_FILE disables signup; it never falls back to another key.
MAIN_MODEL_URL=https://api.example.com
# Optional Docker-internal model relay base; when set it takes precedence over
# MAIN_MODEL_URL and LINK. Example: http://sub2api:8080/v1
SUB2API_RELAY_BASE_URL=

# Server-only credentials. Never put these in frontend/.env or expose them to a browser.
# Use the shared satellite app credential configured by Sub2API. AgentAPI sends the
# currently authenticated mapped user ID in X-Sub2API-On-Behalf-Of for user-scoped
# model, balance and usage calls.
SUB2API_APP_CREDENTIAL=replace-with-satellite-app-credential
# Read-only numeric Sub2API user used only by `agentapi --preflight` to verify
# the public satellite balance/usage bridge. It is not a tenant owner setting.
AGENTAPI_PREFLIGHT_MAIN_USER_ID=
# Docker deployments can set SUB2API_APP_CREDENTIAL_FILE and
# SESSION_SECRET_FILE to mounted secret paths.
SUB2API_SATELLITE=agentapi
# AgentAPI owns its registration policy while Sub2API remains the authority
# that sends and consumes the one-time email code. Disable only when this
# proxy intentionally permits registration without email verification.
AGENT_EMAIL_VERIFY_ENABLED=true
# Optional public-layer SSO. Keep the same >=32-byte secret on Sub2API and AgentAPI.
SUB2API_SSO_SECRET=
AGENTAPI_SSO_AUDIENCE=agentapi

SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true
AGENTAPI_COOKIE_NAME=agentapi_session
AGENTAPI_ADDR=:8080
AGENTAPI_WEB_DIR=/app/web
AGENTAPI_DATABASE_PATH=/app/data/agentapi.db
# Exact public hostnames that lead to the shared AgentAPI entry, separated by
# commas. Do not include a scheme, path or wildcard. Ports are normalized away.
# Persisted tenant custom domains are allowed separately after ownership is
# recorded in the database.
AGENTAPI_SHARED_HOSTS=agentapi.example.com

# Shared production does not configure AGENT_ID/AGENT_DOMAIN/owner. Tenants are
# created by signed Sub2API SSO tickets and persisted in the shared database.
# Set these only while migrating an old single-tenant deployment.
AGENT_ID=
AGENT_DOMAIN=
AGENT_OWNER_MAIN_USER_ID=
AGENT_ENABLED=true
AGENT_NAME=AgentAPI
AGENT_SITE_NAME=AgentAPI
AGENT_SITE_LOGO=/logo.svg
# Keep administrator-console branding across restarts; set true only when an
# operator intentionally wants env values to overwrite the stored branding.
AGENT_BRAND_SYNC=false
# New instances bill each mapped Sub2API user directly. owner_upstream is accepted
# only while migrating an older instance with an existing local-wallet ledger.
AGENT_BILLING_MODE=user_upstream
AGENT_AUTO_BIND_EXISTING_USERS=false
# Deprecated and rejected in upstream-authoritative billing modes; leave empty.
AGENT_INITIAL_BALANCE=
AGENT_MAX_REQUEST_COST=1.00
MAIN_REQUEST_TIMEOUT=90s
# Prefer the authoritative main-site usage log for request settlement. Set
# false only for an older Sub2API build without /v1/sub2api/usage.
AGENT_MAIN_USAGE_API=true
# Maximum duration for an upstream text stream and HTTP response write.
MODEL_STREAM_TIMEOUT=10m
AGENTAPI_WRITE_TIMEOUT=10m
# Set to 0 to disable the background reconciler (manual admin endpoint remains available).
AGENT_SETTLEMENT_RECONCILE_INTERVAL=5m
AGENT_SETTLEMENT_RECONCILE_BATCH=50
AGENT_VIDEO_TASK_RECONCILE_AGE=30m
AGENT_IMAGE_TASK_RECONCILE_AGE=30m

# Direct-billing instances do not accept local payment webhooks or create local
# recharge orders. The UI links users to MAIN_API_URL/purchase instead.
