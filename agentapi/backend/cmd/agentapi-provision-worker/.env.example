# Edge-only deployment worker environment. This global credential is restricted
# by Sub2API to provisioning list/SSE/GET, progress PATCH and activate POST.
MAIN_API_URL=https://api.cc2.cx
AGENT_PROVISIONING_WORKER_CREDENTIAL_FILE=/run/secrets/agent_provisioning_worker_credential

# These paths are mounted on the edge host and passed only to the generated
# AgentAPI Compose project. The AgentAPI model credential is generated for each
# instance and is not configured on the worker host.
SUB2API_SSO_SECRET_FILE=/run/secrets/sub2api_sso_secret

AGENTAPI_NGINX_CONFIG_DIR=/etc/nginx/conf.d
AGENTAPI_NGINX_CONTAINER=nginx-edge
AGENTAPI_EDGE_IPS=203.0.113.10
AGENTAPI_PROVISIONING_STATE_DIR=/var/lib/agentapi-provisioning
# AGENTAPI_IMAGE=cc2cx/agentapi:latest
