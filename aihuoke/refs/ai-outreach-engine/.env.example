# Outreach Engine - local secrets (copy to server/.env)
#
# Product knobs (brand, compliance, send windows, targeting, crawl depth)
# live in the Settings UI — not here.
#
# 1. Copy this file to server/.env
# 2. Fill the keys you need
# 3. Start with SENDER_PROVIDER=dry_run, then switch to brevo when ready

PORT=8787
DATABASE_PATH=./data/outreach.db

# ---------------------------------------------------------------------------
# 1) LLM — OpenAI only
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
LLM_MODEL_REASONING=gpt-5-mini
LLM_MODEL_CHEAP=gpt-5.4-nano

# ---------------------------------------------------------------------------
# 2) Website crawling — Firecrawl
# ---------------------------------------------------------------------------
FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------------
# 3) Search — Serper (~$1 / 1k queries after free credits)
# ---------------------------------------------------------------------------
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# 4) Email verification — Reoon
# ---------------------------------------------------------------------------
REOON_API_KEY=

# ---------------------------------------------------------------------------
# 5) Sending — dry_run | brevo | gmail
# dry_run : full pipeline, no real email leaves the machine (recommended first)
# brevo   : live sender via Brevo API (needs verified domain/sender)
# gmail   : live sender via Gmail SMTP (App Password) — From shows as your Gmail
# ---------------------------------------------------------------------------
SENDER_PROVIDER=dry_run
SENDER_FROM_NAME=Rohit Malhotra
# Legacy fallbacks (used only when provider-specific From/Reply-To are blank)
SENDER_FROM_EMAIL=
SENDER_REPLY_TO=

# Brevo (SENDER_PROVIDER=brevo)
BREVO_API_KEY=
BREVO_FROM_EMAIL=rohit@getobserver.app
BREVO_REPLY_TO=rohit@getobserver.app

# Gmail SMTP (SENDER_PROVIDER=gmail)
# 1) Turn on 2-Step Verification
# 2) App Password: https://myaccount.google.com/apppasswords
# GMAIL_FROM_EMAIL=you@gmail.com
# GMAIL_REPLY_TO=you@gmail.com
# GMAIL_APP_PASSWORD=
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=465
