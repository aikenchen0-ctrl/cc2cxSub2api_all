# Companion project origins used by the Sub2API sidebar.
# Leave unset for automatic local/production defaults.
# Set these in the production build environment when your domains differ.
VITE_CANVAS_URL=https://canvas.cc2.cx
VITE_QRCODE_URL=https://qrcode.cc2.cx
VITE_PUBLIC_API_URL=https://api.cc2.cx
# Canonical Sub2API model/API link. Also accepts localhost:18080.
# Set this single value in CI/CD when all projects use the same gateway.
# VITE_LINK=https://api.cc2.cx
# VITE_CANVAS_URL=https://canvas.cc2.cx
# VITE_QRCODE_URL=https://qrcode.cc2.cx
# VITE_AICUT_LINK=https://aicut.cc2.cx
# VITE_AIEXCEL_LINK=https://aiexcel.cc2.cx
# VITE_YIBIAO_LINK=https://bidmonitor.example.com
# VITE_CANVAS_LINK=https://canvas.cc2.cx
# VITE_JU_LINK=https://ju.cc2.cx
# VITE_LIVART_LINK=https://livart.cc2.cx
# VITE_PPT_LINK=https://ppt.cc2.cx
# VITE_QRCODE_LINK=https://qrcode.cc2.cx
# VITE_SCREEN2CODE_LINK=https://screen2code.cc2.cx

# Optional SSO endpoint overrides for all sidebar projects.
# By default these are generated from the current Sub2API API URL, so they
# already switch correctly between local and production deployments.
# VITE_CANVAS_SSO_URL=https://api.example.com/api/v1/auth/integrations/canvas/start?next=%2F
# VITE_SHORT_DRAMA_SSO_URL=https://api.example.com/api/v1/auth/integrations/ju/start?next=%2Fprojects
# VITE_SUPER_CANVAS_SSO_URL=https://api.example.com/api/v1/auth/integrations/livart/start?next=%2F
# VITE_PPT_SSO_URL=https://api.example.com/api/v1/auth/integrations/ppt/start?next=%2Fupload
# VITE_AICUT_SSO_URL=https://api.example.com/api/v1/auth/integrations/aicut/start?next=%2F
# VITE_SCREEN2CODE_SSO_URL=https://api.example.com/api/v1/auth/integrations/screen2code/start?next=%2F
# VITE_AIEXCEL_SSO_URL=https://api.example.com/api/v1/auth/integrations/aiexcel/start?next=%2F
# VITE_YIBIAO_SSO_URL=https://api.example.com/api/v1/auth/integrations/yibiao/start?next=%2F

# Optional API endpoint overrides.
# VITE_API_BASE_URL=/api/v1
# VITE_DEV_PROXY_TARGET=http://localhost:18080
