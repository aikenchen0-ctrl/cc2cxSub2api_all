# Production routing values for the cc2.cx reverse proxies.
# Copy these four lines into deploy/.env (keep all secrets from the existing
# deployment unchanged), or run apply-online-domains.sh on the server.
# Set SUB2API_SSO_SECRET here and in the qrcode/yibiao runtime environment to
# the same random value (at least 32 characters). Never commit the real value.
LINK=https://api.cc2.cx
qrcode_link=https://qrcode.cc2.cx
yibiao_link=https://yibiao.cc2.cx
QRCODE_SSO_CALLBACK_URL=https://qrcode.cc2.cx/api/auth/sso/callback
YIBIAO_SSO_CALLBACK_URL=https://yibiao.cc2.cx/api/auth/sso/callback
