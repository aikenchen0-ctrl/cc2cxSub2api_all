# Satellite containers talk to Sub2API by Docker DNS, not host LINK.
# Host menu URLs stay in .env as localhost:{port} from 本地链接.txt.
# Do not inherit Sub2API's POSTGRES_* into satellite databases.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=livart_postgres_change_me
POSTGRES_DB=app
LINK=http://sub2api:8080
SUB2API_BASE=http://sub2api:8080
SUB2API_RELAY_BASE_URL=http://sub2api:8080/v1
SUB2API_APP_CREDENTIAL=sat-cc2cx-local-app-credential-32b-min
CUSTOM_LLM_URL=http://sub2api:8080/v1
CANVAS_AUTO_MIGRATE=true
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=sub2api
PRESENTON_HTTP_HOST_PORT=8341
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
